/* =============================================================================
   GIAP Desktop — Section Styles
   BEM-like structural classes for the HeroUI redesign.
   Variables reference design-tokens.css (aliases resolve there).
   ============================================================================= */

/* ─── App Shell ─── */
.app-shell {
  flex: 1;
  display: grid;
  grid-template-columns: var(--sidebar-width) 1fr;
  background: linear-gradient(180deg, #fdf8fb 0%, var(--grey-50) 280px, var(--grey-50) 100%);
  min-height: 0;
  overflow: hidden;
  position: relative;
}

.app-main {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.app-content {
  flex: 1;
  overflow-y: auto;
  padding: 22px 32px 80px;
}
.app-content::-webkit-scrollbar { width: 8px; }
.app-content::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 8px; }

/* ─── Page header ─── */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--grey-100);
}
.page-header__title {
  font-family: var(--font-heading);
  font-weight: var(--weight-bold);
  font-size: 16px;
  margin: 0;
  letter-spacing: -0.005em;
}
.page-header__action { display: flex; gap: 8px; }

/* ─── Sidebar ─── */
.sidebar {
  background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
  border-right: 1px solid var(--grey-200);
  display: flex;
  flex-direction: column;
  padding: 14px 0 12px;
  overflow: hidden;
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  transition: var(--sidebar-transition);
}
.sidebar.is-collapsed {
  width: var(--sidebar-width-collapsed);
  min-width: var(--sidebar-width-collapsed);
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px 16px;
}
.sidebar__logo {
  width: 30px; height: 30px;
  border-radius: 8px;
  background: #fff;
  border: 1px solid var(--grey-200);
  display: grid;
  place-items: center;
  overflow: hidden;
  flex-shrink: 0;
}
.sidebar__logo img { width: 26px; height: 26px; object-fit: contain; }
.sidebar__brand-name {
  font-family: var(--font-heading);
  font-weight: var(--weight-bold);
  font-size: var(--text-base);
  color: var(--fg);
  letter-spacing: -0.01em;
}

.sidebar__nav {
  flex: 1;
  overflow-y: auto;
  padding: 4px 10px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.sidebar__nav::-webkit-scrollbar { width: 6px; }
.sidebar__nav::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 6px; }

.sidebar__group { display: flex; flex-direction: column; gap: 2px; }
.sidebar__group-label {
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.12em;
  color: var(--grey-500);
  padding: 8px 8px 4px;
  text-transform: uppercase;
}
.sidebar__item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 7px 10px;
  border-radius: 8px;
  border: 0;
  background: transparent;
  color: var(--grey-700);
  font-size: var(--text-base);
  font-family: var(--font-body);
  font-weight: var(--weight-medium);
  cursor: pointer;
  text-align: left;
  width: 100%;
  transition: background 120ms;
}
.sidebar__item:hover { background: var(--grey-100); }
.sidebar__item.is-active {
  background: var(--purple-50);
  color: var(--purple-700);
}
.sidebar__item.is-active .sidebar__icon { color: var(--purple-600); }
.sidebar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--grey-500);
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.sidebar__icon svg {
  width: 16px;
  height: 16px;
}

.sidebar__footer {
  padding: 10px 14px 8px;
  border-top: 1px solid var(--grey-200);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.sidebar__status {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; color: var(--grey-600);
}
.sidebar__status-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--grey-400);
}
.sidebar__status-dot.is-connected {
  background: var(--color-success);
  box-shadow: 0 0 0 3px rgba(52, 199, 89, 0.15);
}
.sidebar__actions { display: flex; gap: 6px; }
.sidebar__action-btn {
  flex: 1; min-width: 0;
  font-size: 12px !important;
  height: 30px !important;
  border-radius: 8px !important;
  border: 1px solid var(--grey-300) !important;
  font-weight: var(--weight-medium) !important;
  gap: 5px;
}

/* ─── Generic screen + cards ─── */
.screen { display: flex; flex-direction: column; gap: 20px; max-width: 880px; }

/* ── Card system overrides — HeroUI defaults zero padding, wrong radius ── */
.giap-card,
.card--voice,
[data-slot="card"] {
  background: #fff !important;
  border: 1px solid var(--grey-200) !important;
  border-radius: var(--radius-card) !important;
  box-shadow: none !important;
}
.card--voice {
  background: linear-gradient(135deg, #fbf6ff 0%, #ffffff 60%) !important;
  border-color: var(--purple-100) !important;
}
/* Ensure CardContent always provides inner padding */
[data-slot="card-content"] {
  padding: 16px !important;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 8px;
}
.card-header__right { display: flex; align-items: center; gap: 8px; }
.card__label {
  font-size: 10px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  color: var(--grey-400);
  text-transform: uppercase;
}
.card__divider { margin: 14px 0 12px; }
.card-body--tight { padding-top: 8px; }
.card-body--list { padding: 4px; }
.card-body--flush { padding: 0; }

/* ─── Dashboard ─── */
.card--voice {
  background: linear-gradient(135deg, #fbf6ff 0%, #ffffff 60%);
  border: 1px solid var(--purple-100);
}
.voice-card {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: center;
}
.voice-card__main { display: flex; gap: 14px; align-items: flex-start; }
.voice-card__icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  background: var(--purple-100);
  color: var(--purple-700);
  display: grid; place-items: center;
  flex-shrink: 0;
}
.voice-card__text h3 {
  font-family: var(--font-heading);
  font-size: 17px; font-weight: var(--weight-bold); margin: 0 0 4px;
}
.voice-card__text p {
  font-size: var(--text-base); color: var(--grey-600); margin: 0 0 8px; max-width: 480px;
}
.voice-card__hint {
  font-size: var(--text-sm); color: var(--grey-600);
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
}
.voice-card__right {
  display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
  padding-right: 8px; flex-shrink: 0;
}
.voice-card__state {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--purple-700);
  font-weight: var(--weight-semibold);
}
.voice-card__switch-label { font-size: var(--text-sm); color: var(--grey-600); }
.voice-card__cta {
  display: flex; gap: 8px; padding-top: 14px;
  border-top: 1px dashed var(--grey-200);
  margin-top: 14px;
}

.vu { display: flex; align-items: flex-end; gap: 3px; height: 28px; }
.vu__bar {
  width: 4px;
  background: var(--grey-200);
  border-radius: 2px;
  transition: background 200ms, height 300ms var(--ease-out);
}
.vu__bar.is-lit { background: var(--purple-500); }

.dash-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 16px;
  align-items: stretch;
}
.dash-grid > * { display: flex; flex-direction: column; }
.dash-grid [data-slot="card-content"] { flex: 1; }
.server-row {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
}
.server-row__state {
  display: flex; align-items: center; gap: 6px;
  font-size: 14px; font-weight: var(--weight-medium);
}
.server-row__dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--color-success);
  box-shadow: 0 0 0 3px rgba(52, 199, 89, 0.15);
}
.server-row__url { max-width: 220px; }

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.metric { padding: 10px 12px; border-radius: 10px; background: var(--grey-50); border: 1px solid var(--grey-100); }
.metric__label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--grey-500); letter-spacing: 0.08em; text-transform: uppercase; }
.metric__value { font-family: var(--font-mono); font-size: var(--text-base); font-weight: var(--weight-semibold); color: var(--fg); margin-top: 2px; }
.metric__value--warn { color: var(--color-warning); }
.metric__value--ok   { color: var(--color-success); }

.quick-actions { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
.quick-action {
  display: flex; align-items: center; gap: 10px;
  width: 100%; padding: 10px; border-radius: 10px;
  border: 1px solid transparent; background: transparent; cursor: pointer;
  font-family: var(--font-body); font-size: var(--text-base);
  text-align: left; transition: background 120ms, border-color 120ms;
}
.quick-action:hover { background: var(--purple-50); border-color: var(--purple-100); }
.quick-action__icon {
  width: 30px; height: 30px; border-radius: 8px;
  background: var(--grey-100); color: var(--grey-700);
  display: grid; place-items: center;
}
.quick-action:hover .quick-action__icon { background: #fff; color: var(--purple-600); }
.quick-action__label { flex: 1; font-weight: var(--weight-medium); }
.quick-action__arrow { color: var(--grey-400); transition: transform 120ms; }
.quick-action:hover .quick-action__arrow { color: var(--purple-500); transform: translateX(2px); }

/* ─── Active model roles ─── */
.role-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.role-chip {
  display: flex;
  background: var(--grey-50);
  border: 1px solid transparent;
  border-radius: 10px;
  overflow: hidden;
  min-width: 0;
  transition: background var(--transition-fast), border-color var(--transition-fast);
}
.role-chip.is-set {
  background: #fff;
  border-color: var(--grey-200);
}
.role-chip__bar {
  width: 3px;
  background: var(--grey-200);
  flex-shrink: 0;
  transition: background var(--transition-fast);
}
.role-chip.is-set .role-chip__bar { background: var(--purple-500); }
.role-chip--secondary.is-set .role-chip__bar { background: var(--purple-500); }
.role-chip--warning.is-set   .role-chip__bar { background: var(--color-warning); }
.role-chip--success.is-set   .role-chip__bar { background: var(--color-success); }
.role-chip--primary.is-set   .role-chip__bar { background: #0072f5; }
.role-chip--danger.is-set    .role-chip__bar { background: var(--color-destructive); }
.role-chip__body { padding: 8px 10px; flex: 1; min-width: 0; }
.role-chip__head {
  display: flex; align-items: center; gap: 6px;
  font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 0.06em;
  color: var(--grey-400);
  text-transform: uppercase;
  margin-bottom: 3px;
  transition: color var(--transition-fast);
}
.role-chip.is-set .role-chip__head { color: var(--grey-600); }
.role-chip--secondary.is-set .role-chip__head { color: var(--purple-700); }
.role-chip--warning.is-set   .role-chip__head { color: #b08000; }
.role-chip--success.is-set   .role-chip__head { color: #0e8a4a; }
.role-chip__role { letter-spacing: 0.08em; }
.role-chip__value {
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}
.role-chip__value--empty {
  color: var(--grey-300);
  font-style: normal;
}
.role-chip__value--set {
  color: var(--fg);
}

/* ─── Models screen ─── */
.mem-progress__label {
  display: flex; justify-content: space-between; width: 100%;
  font-size: 11px; font-weight: var(--weight-semibold); letter-spacing: 0.08em;
  color: var(--grey-500); text-transform: uppercase;
}
.mem-progress__num { color: var(--grey-700); font-family: var(--font-mono); }

.models-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 4px 0 0;
}
.models-toolbar__tabs { padding: 0; }
.models-toolbar__right { display: flex; align-items: center; gap: 8px; }
.models-toolbar__search { width: 200px; }
.tab-title {
  display: flex; align-items: center; gap: 6px; font-size: var(--text-sm); font-weight: var(--weight-semibold);
}
.tab-title__count {
  background: var(--grey-100);
  color: var(--grey-400);
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  font-size: 9px;
  font-weight: var(--weight-semibold);
  min-width: 16px;
  text-align: center;
}

.seg-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 0;
}
.seg-toolbar__count {
  display: flex; align-items: center; gap: 6px;
  font-size: var(--text-xs); color: var(--grey-400);
}

.seg-banner {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 12px; border-radius: 8px;
  font-size: 10px; font-weight: var(--weight-semibold); letter-spacing: 0.06em; text-transform: uppercase;
}
.seg-banner--info { background: rgba(0,114,245,0.05); color: #4d94d4; }
.seg-banner--warn { background: rgba(255,149,0,0.06); color: #c49a3d; }

.models-list {
  padding: 0;
  border: 1px solid var(--grey-100);
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
}

.giap-model-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  transition: background 120ms;
  border: none;
}
.giap-model-row + .giap-model-row { border-top: 1px solid var(--grey-100); }
.giap-model-row:hover { background: var(--grey-50); }
.giap-model-row.is-active {
  background: var(--purple-50);
  border-left: 3px solid var(--color-accent);
}
.giap-model-row__title-row {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
}
.giap-model-row__name {
  font-size: var(--text-base); font-weight: var(--weight-semibold); color: var(--fg);
}
.giap-model-row__meta {
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  color: var(--grey-400);
  font-weight: var(--weight-regular);
}
.giap-model-row__file {
  font-size: 10px;
  color: var(--grey-300);
  margin-top: 1px;
}
.giap-model-row__file code { font-family: var(--font-mono); }
.giap-model-row__actions {
  display: flex; align-items: center; gap: 6px;
  opacity: 0;
  transition: opacity var(--transition-fast);
}
.giap-model-row:hover .giap-model-row__actions,
.giap-model-row.is-active .giap-model-row__actions,
.giap-model-row.always-actions .giap-model-row__actions {
  opacity: 1;
}
.giap-model-row__trash { color: var(--grey-400); transition: color var(--transition-fast); }
.giap-model-row__trash:hover { color: var(--color-destructive); }

.role-select { display: flex; gap: 4px; }

/* Capability badges — lightweight alternative to HeroUI Chip */
.cap-badge {
  display: inline-block;
  font-size: 9px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.02em;
  color: var(--grey-400);
  background: var(--grey-50);
  border: 1px solid var(--grey-100);
  padding: 1px 5px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  vertical-align: middle;
}

.github-accordion { background: var(--grey-50); border: 1px solid var(--grey-100); border-radius: 10px; box-shadow: none; }
.acc-title { font-weight: var(--weight-semibold); font-size: var(--text-sm); }
.gh-empty {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 4px; font-size: var(--text-sm); color: var(--grey-600);
}

/* ── System stats bar ────────────────────────────────────────── */

.sys-stats {
  display: flex; flex-direction: column; gap: 6px;
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-md); padding: 10px var(--space-4);
}
.sys-stats__row {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.sys-stats__label {
  font-size: var(--text-xs); font-weight: 700; color: var(--color-text-secondary);
  text-transform: uppercase; letter-spacing: 0.06em;
}
.sys-stats__value {
  font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg);
  flex: 1;
}

/* ── Download progress ───────────────────────────────────────── */

.dl-progress {
  display: flex; flex-direction: column; gap: var(--space-2);
  background: var(--color-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-md); padding: var(--space-3) var(--space-4);
}
.dl-progress__header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px;
}
.dl-progress__title {
  font-size: var(--text-xs); font-weight: 700; color: var(--color-text-secondary);
  text-transform: uppercase; letter-spacing: 0.06em;
}
.dl-progress__item { display: flex; flex-direction: column; gap: 4px; }
.dl-progress__item-header {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
}
.dl-progress__filename {
  font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text);
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dl-progress__status {
  font-size: var(--text-xs); flex-shrink: 0; font-family: var(--font-mono);
  color: var(--color-text-secondary);
}
.dl-progress__status--done { color: var(--color-success); }
.dl-progress__status--error { color: var(--color-destructive); }
.dl-progress__track {
  height: 6px; background: rgba(23,22,22,0.08); border-radius: 3px; overflow: hidden;
}
.dl-progress__fill {
  height: 100%; border-radius: 3px; transition: width 0.4s ease;
  background: var(--color-accent);
}
.dl-progress__fill--done { background: var(--color-success); }
.dl-progress__fill--error { background: var(--color-destructive); }
.dl-progress__fill--downloading {
  background: linear-gradient(90deg, var(--color-accent), var(--color-accent-hover, #6d4de6));
  animation: dl-shimmer 1.5s ease-in-out infinite;
}
@keyframes dl-shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* ── Spin animation for loaders ─────────────────────────────── */

.spin { animation: spin-anim 1s linear infinite; }
@keyframes spin-anim { to { transform: rotate(360deg); } }

.muted-foot {
  font-size: var(--text-sm);
  color: var(--grey-500);
  margin: 4px 6px;
}
.muted-foot code {
  background: var(--grey-100);
  padding: 1px 4px; border-radius: 4px;
  font-size: 11px;
}

/* ─── Chat ─── */
.screen--chat { max-width: 100%; height: calc(100vh - 80px); display: flex; flex-direction: column; }
.chat-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--grey-200);
  margin-bottom: 16px;
  position: relative;
}
.chat-toolbar__left { display: flex; align-items: center; gap: 10px; }
.chat-toolbar__title { font-size: 16px; }
.chat-toolbar__right { display: flex; gap: 6px; }

/* ─── Session Dropdown ─── */
.session-dropdown {
  position: absolute; top: calc(100% + 4px); left: 0; z-index: 50;
  width: 320px; max-height: 420px;
  background: #fff; border: 1px solid var(--grey-200);
  border-radius: var(--radius-card, 10px);
  box-shadow: 0 8px 24px rgba(28,28,28,0.12);
  display: flex; flex-direction: column; overflow: hidden;
}
.session-dropdown__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 12px; border-bottom: 1px solid var(--grey-100);
}
.session-dropdown__list { flex: 1; overflow-y: auto; padding: 4px 0; }
.session-dropdown__group { padding: 4px 0; }
.session-dropdown__group-label {
  font-size: 11px; font-weight: 600; color: var(--grey-400);
  text-transform: uppercase; letter-spacing: 0.05em;
  padding: 6px 14px 4px;
}
.session-dropdown__item {
  display: flex; align-items: center; gap: 8px;
  width: 100%; padding: 8px 14px; border: none; background: none;
  cursor: pointer; text-align: left; font-size: 13px;
  transition: background 100ms;
}
.session-dropdown__item:hover { background: var(--grey-50, #fafafa); }
.session-dropdown__item.is-active { background: var(--purple-50, #f5f0ff); }
.session-dropdown__title {
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  color: var(--color-text);
}
.session-dropdown__meta {
  display: flex; gap: 6px; font-size: 11px; color: var(--grey-400);
  white-space: nowrap; flex-shrink: 0;
}

.chat-body { flex: 1; overflow-y: auto; padding: 4px 4px 12px; }
.chat-thread { display: flex; flex-direction: column; gap: 18px; }

.bubble { display: flex; flex-direction: column; gap: 6px; }
.bubble__author {
  display: flex; align-items: center; gap: 6px;
  font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--grey-500);
}
.bubble--user .bubble__author { color: var(--grey-500); }
.bubble--assistant .bubble__author { color: var(--purple-700); }
.bubble__avatar {
  width: 18px; height: 18px;
  background: var(--purple-500);
  color: #fff;
}
.bubble__avatar-fallback { color: #fff; font-weight: var(--weight-bold); font-size: 11px; }
.bubble__body {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--fg);
  background: #fff;
  border: 1px solid var(--grey-200);
  border-radius: 10px;
  padding: 10px 14px;
  max-width: 85%;
  text-wrap: pretty;
}
@media (min-width: 900px) {
  .bubble__body { max-width: 80%; }
}
@media (min-width: 1200px) {
  .bubble__body { max-width: 75%; }
}
.bubble--user .bubble__body {
  background: var(--purple-50);
  border-color: var(--purple-100);
  align-self: flex-end;
}
.stream-dots { display: inline-flex; gap: 4px; }
.stream-dots span {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--grey-400);
  animation: streamDot 1.2s ease-in-out infinite;
}
.stream-dots span:nth-child(2) { animation-delay: 150ms; }
.stream-dots span:nth-child(3) { animation-delay: 300ms; }
@keyframes streamDot { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

.chat-composer {
  border-top: 1px solid var(--grey-200);
  padding-top: 12px;
}
.chat-composer__inner {
  display: flex; align-items: flex-end; gap: 8px;
  width: 100%;
  background: #fff;
  border: 1px solid var(--grey-300);
  border-radius: 12px;
  padding: 6px 8px 6px 0;
}
.chat-composer__field {
  flex: 1 1 auto;
  min-width: 0;
  width: 100%;
}
.chat-composer__actions { display: flex; gap: 4px; padding-bottom: 4px; }
.chat-composer__hint {
  display: flex; gap: 8px; align-items: center;
  font-size: 11px; color: var(--grey-500);
  margin-top: 6px;
  padding: 0 4px;
}

/* ── Model selector trigger ── */
.model-selector-trigger {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px 2px 6px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--grey-200);
  background: var(--grey-50);
  cursor: pointer;
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--grey-600);
  transition: background var(--transition-fast), border-color var(--transition-fast);
  white-space: nowrap;
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}
.model-selector-trigger:hover {
  background: var(--purple-50);
  border-color: var(--purple-200);
  color: var(--purple-700);
}
.model-selector-trigger.is-open {
  background: var(--purple-50);
  border-color: var(--purple-300);
  color: var(--purple-700);
}

/* ── Model selector dropdown ── */
.model-selector-dropdown {
  position: absolute;
  bottom: calc(100% + 6px);
  left: 0;
  z-index: 60;
  min-width: 280px;
  max-width: 380px;
  max-height: 360px;
  background: var(--color-bg, #fff);
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card, 10px);
  box-shadow: 0 8px 28px rgba(28,28,28,0.14), 0 2px 8px rgba(28,28,28,0.06);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: fadeIn 0.12s ease;
}
.model-selector-dropdown__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px;
  border-bottom: 1px solid var(--grey-100);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--fg);
}
.model-selector-dropdown__list {
  flex: 1;
  overflow-y: auto;
  padding: 4px 6px;
}
.model-selector-dropdown__group-label {
  font-size: 10px;
  font-weight: var(--weight-bold);
  color: var(--grey-400);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 10px 10px 4px;
}
.model-selector-dropdown__group-label:first-child { padding-top: 6px; }
.model-selector-dropdown__item {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%;
  padding: 8px 10px;
  border: none;
  background: none;
  border-radius: 6px;
  cursor: pointer;
  text-align: left;
  font-size: var(--text-sm, 13px);
  font-family: var(--font-mono);
  color: var(--fg);
  transition: background 100ms;
  gap: 10px;
}
.model-selector-dropdown__item:hover { background: var(--grey-50); }
.model-selector-dropdown__item.is-active {
  background: var(--purple-50);
  color: var(--purple-700);
}
.model-selector-dropdown__item-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: var(--weight-medium);
}
.model-selector-dropdown__item-meta {
  display: flex; align-items: center; gap: 6px;
  flex-shrink: 0;
  font-size: 10px;
  color: var(--grey-400);
  font-family: var(--font-mono);
  white-space: nowrap;
}
.model-selector-dropdown__empty {
  padding: 20px 16px;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--grey-400);
}

/* ─── Memory ─── */

/* Segment color tokens — muted, harmonious with Jarida warm palette */
:root {
  --mem-identity:     #6d28d9;
  --mem-identity-bg:  rgba(109, 40, 217, 0.07);
  --mem-preference:   #2563eb;
  --mem-preference-bg: rgba(37, 99, 235, 0.07);
  --mem-correction:   #b91c1c;
  --mem-correction-bg: rgba(185, 28, 28, 0.07);
  --mem-relationship: #15803d;
  --mem-relationship-bg: rgba(21, 128, 61, 0.07);
  --mem-project:      #c2410c;
  --mem-project-bg:   rgba(194, 65, 12, 0.07);
  --mem-knowledge:    #0f766e;
  --mem-knowledge-bg: rgba(15, 118, 110, 0.07);
  --mem-context:      #71717a;
  --mem-context-bg:   rgba(113, 113, 122, 0.07);
}

/* Add form */
.mem-add { display: flex; gap: 8px; }
.mem-add__input { flex: 1; }

/* Expanded add form */
.mem-add-form { display: flex; flex-direction: column; gap: 12px; }
.mem-add-form__row { display: flex; gap: 8px; align-items: flex-start; }
.mem-add-form__fields {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
  padding-top: 4px;
}
.mem-add-form__field-label {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.06em;
  color: var(--grey-500);
  text-transform: uppercase;
  margin-bottom: 4px;
}
.mem-add-form__select,
.mem-add-form__range {
  width: 100%;
  height: 32px;
  padding: 0 8px;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-family: var(--font-body);
  background: #fff;
  color: var(--fg);
  outline: none;
  transition: border-color var(--transition-fast);
  box-sizing: border-box;
  cursor: pointer;
  appearance: auto;
}
.mem-add-form__select:focus,
.mem-add-form__range:focus { border-color: var(--color-accent); }
.mem-add-form__range {
  padding: 0 4px;
  height: 32px;
  accent-color: var(--color-accent);
}
.mem-add-form__importance-row {
  display: flex; align-items: center; gap: 6px;
}
.mem-add-form__importance-val {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--grey-500);
  min-width: 26px;
  text-align: right;
}
.mem-add-form__toggle {
  font-size: var(--text-sm);
  color: var(--grey-500);
  background: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 0;
  font-family: var(--font-body);
  text-decoration: underline;
  text-decoration-style: dashed;
  text-underline-offset: 2px;
}
.mem-add-form__toggle:hover { color: var(--fg); }

/* Segment filter tabs */
.mem-filter {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
  padding: 2px 0;
}
.mem-filter__btn {
  display: inline-flex; align-items: center; gap: 5px;
  height: 26px; padding: 0 10px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--grey-200);
  background: transparent;
  font-size: var(--text-xs);
  font-family: var(--font-body);
  font-weight: var(--weight-semibold);
  color: var(--grey-500);
  cursor: pointer;
  transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  white-space: nowrap;
}
.mem-filter__btn:hover {
  background: var(--grey-50);
  color: var(--fg);
}
.mem-filter__btn.is-active {
  background: var(--purple-50);
  border-color: var(--purple-200);
  color: var(--purple-700);
}
.mem-filter__count {
  font-size: 9px;
  padding: 1px 5px;
  border-radius: var(--radius-pill);
  background: var(--grey-100);
  color: var(--grey-400);
  min-width: 14px;
  text-align: center;
}
.mem-filter__btn.is-active .mem-filter__count {
  background: var(--purple-100);
  color: var(--purple-700);
}

/* Stats bar */
.mem-stats {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  padding: 4px 0 0;
}
/* Chip is always neutral — colored dot provides the segment hint */
.mem-stats__chip {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11px;
  font-weight: var(--weight-medium);
  padding: 3px 9px;
  border-radius: var(--radius-pill);
  background: var(--grey-100) !important;
  color: var(--grey-600) !important;
  white-space: nowrap;
  border: none !important;
}
.mem-stats__dot {
  width: 6px; height: 6px; border-radius: 50%;
  flex-shrink: 0;
}

/* Search bar — full width, integrated look */
.mem-search {
  position: relative;
  width: 100%;
}
.mem-search__icon {
  position: absolute;
  left: 11px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--grey-400);
  pointer-events: none;
  display: flex;
  align-items: center;
}
.mem-search__input {
  width: 100%;
  height: 36px;
  padding: 0 12px 0 34px;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-md);
  background: var(--grey-50);
  color: var(--fg);
  font-size: 13px;
  font-family: var(--font-body);
  outline: none;
  transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
  box-sizing: border-box;
}
.mem-search__input::placeholder {
  color: var(--grey-400);
}
.mem-search__input:focus {
  border-color: var(--color-accent);
  background: #fff;
  box-shadow: 0 0 0 3px var(--color-accent-subtle);
}
.mem-search__clear {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  width: 20px; height: 20px;
  border: none;
  border-radius: 4px;
  background: var(--grey-200);
  color: var(--grey-500);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.mem-search__clear:hover { background: var(--grey-300); color: var(--fg); }

/* Memory card list */
.mem-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.mem-card {
  border-bottom: 1px solid var(--grey-100);
  padding: 14px 8px 14px 12px;
  transition: background var(--transition-fast);
  border-radius: 6px;
  border-left: 2px solid transparent;
}
.mem-card:last-child { border-bottom: none; }
.mem-card:hover {
  background: var(--grey-50);
  border-left-color: var(--grey-200);
}
.mem-card:hover .mem-card__actions { opacity: 1; }

/* Per-segment left border on hover */
.mem-card:has(.mem-seg-badge--identity):hover    { border-left-color: var(--mem-identity); }
.mem-card:has(.mem-seg-badge--preference):hover  { border-left-color: var(--mem-preference); }
.mem-card:has(.mem-seg-badge--correction):hover  { border-left-color: var(--mem-correction); }
.mem-card:has(.mem-seg-badge--relationship):hover{ border-left-color: var(--mem-relationship); }
.mem-card:has(.mem-seg-badge--project):hover     { border-left-color: var(--mem-project); }
.mem-card:has(.mem-seg-badge--knowledge):hover   { border-left-color: var(--mem-knowledge); }
.mem-card:has(.mem-seg-badge--context):hover     { border-left-color: var(--mem-context); }

.mem-card__header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

/* Segment icon bubble */
.mem-card__seg-icon {
  width: 30px; height: 30px;
  border-radius: 9px;
  display: grid; place-items: center;
  flex-shrink: 0;
  margin-top: 1px;
}

.mem-card__body { flex: 1; min-width: 0; }

/* Top row: segment badge + tier */
.mem-card__top {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: wrap;
  margin-bottom: 7px;
}

/* Action buttons column — hidden until hover */
.mem-card__actions {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex-shrink: 0;
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.mem-seg-badge {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: 10px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.03em;
  text-transform: uppercase;
  padding: 2px 8px 2px 6px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  line-height: 1.6;
}

/* Segment badge color variants */
.mem-seg-badge--identity    { background: var(--mem-identity-bg);     color: var(--mem-identity); }
.mem-seg-badge--preference  { background: var(--mem-preference-bg);   color: var(--mem-preference); }
.mem-seg-badge--correction  { background: var(--mem-correction-bg);   color: var(--mem-correction); }
.mem-seg-badge--relationship{ background: var(--mem-relationship-bg); color: var(--mem-relationship); }
.mem-seg-badge--project     { background: var(--mem-project-bg);      color: var(--mem-project); }
.mem-seg-badge--knowledge   { background: var(--mem-knowledge-bg);    color: var(--mem-knowledge); }
.mem-seg-badge--context     { background: var(--mem-context-bg);      color: var(--mem-context); }
.mem-seg-badge--none        { background: var(--grey-100);            color: var(--grey-500); }

/* Segment icon color variants */
.mem-card__seg-icon--identity    { background: var(--mem-identity-bg);     color: var(--mem-identity); }
.mem-card__seg-icon--preference  { background: var(--mem-preference-bg);   color: var(--mem-preference); }
.mem-card__seg-icon--correction  { background: var(--mem-correction-bg);   color: var(--mem-correction); }
.mem-card__seg-icon--relationship{ background: var(--mem-relationship-bg); color: var(--mem-relationship); }
.mem-card__seg-icon--project     { background: var(--mem-project-bg);      color: var(--mem-project); }
.mem-card__seg-icon--knowledge   { background: var(--mem-knowledge-bg);    color: var(--mem-knowledge); }
.mem-card__seg-icon--context     { background: var(--mem-context-bg);      color: var(--mem-context); }
.mem-card__seg-icon--none        { background: var(--grey-100);            color: var(--grey-400); }

/* Tier badge */
.mem-tier-badge {
  font-size: 10px;
  font-weight: var(--weight-medium);
  letter-spacing: 0.02em;
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  font-family: var(--font-mono);
  line-height: 1.6;
}
.mem-tier-badge--permanent {
  background: rgba(140, 75, 255, 0.08);
  color: var(--purple-600);
  border: 1px solid rgba(140, 75, 255, 0.18);
}
.mem-tier-badge--long {
  background: transparent;
  color: var(--grey-500);
  border: 1px solid var(--grey-250, var(--grey-300));
}
.mem-tier-badge--short {
  background: transparent;
  color: var(--grey-400);
  border: 1px dashed var(--grey-300);
}

/* Source indicator */
.mem-source-badge {
  font-size: 10px;
  color: var(--grey-400);
  font-family: var(--font-mono);
  font-weight: var(--weight-regular);
  line-height: 1.6;
}

/* Content text */
.mem-card__content {
  font-size: var(--text-base);
  color: var(--fg);
  line-height: 1.6;
  user-select: text;
}

/* Importance — lives inline in the meta row */
.mem-card__meta-item--importance {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.mem-importance__track {
  display: inline-block;
  width: 52px;
  height: 2px;
  background: var(--grey-200);
  border-radius: 2px;
  overflow: hidden;
  flex-shrink: 0;
  vertical-align: middle;
  position: relative;
}
.mem-importance__fill {
  display: block;
  height: 100%;
  border-radius: 2px;
  opacity: 0.45;
  transition: width 0.3s var(--ease-out);
}
.mem-importance__label {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--grey-400);
  flex-shrink: 0;
}

/* Footer meta row */
.mem-card__meta {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 8px;
}
.mem-card__meta-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 11px;
  color: var(--grey-400);
  white-space: nowrap;
}

/* Action buttons (edit / delete) */
.mem-card__delete {
  display: grid;
  place-items: center;
  width: 26px; height: 26px;
  border: none; border-radius: 6px;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  flex-shrink: 0;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.mem-card__delete:hover { background: var(--color-destructive-soft); color: var(--color-destructive); }

/* Legacy row — kept for backward compat; may be unused now */
.mem-row {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  transition: background 120ms;
}
.mem-row + .mem-row { border-top: 1px solid var(--grey-100); border-radius: 0; }
.mem-row:hover { background: var(--grey-50); }
.mem-row__bullet {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--purple-50); color: var(--purple-600);
  display: grid; place-items: center;
}
.mem-row__text { font-size: var(--text-base); color: var(--fg); line-height: 1.5; }
.mem-row__date { font-size: 11px; color: var(--grey-500); white-space: nowrap; }

/* ─── Skills ─── */
.skills-form { display: flex; flex-direction: column; gap: 12px; }
.skills-form__actions { display: flex; justify-content: flex-end; gap: 8px; }
.skill-row {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 10px;
}
.skill-row + .skill-row { border-top: 1px solid var(--grey-100); border-radius: 0; }
.skill-row__icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: var(--purple-50); color: var(--purple-600);
  display: grid; place-items: center;
}
.skill-row__name { font-size: var(--text-base); font-weight: var(--weight-semibold); }
.skill-row__instr { font-size: var(--text-sm); color: var(--grey-600); margin-top: 2px; }

/* ─── Logs ─── */
.logs-toolbar [role="tablist"] {
  display: flex; gap: 2px; padding: 3px;
  background: var(--grey-100); border-radius: 10px;
}
.logs-toolbar [role="tab"] {
  padding: 4px 14px; border-radius: 7px;
  font-size: 12px; font-weight: 600;
  cursor: pointer; transition: background 120ms;
}
.logs-toolbar [role="tab"][aria-selected="true"] {
  background: var(--color-accent); color: #fff;
}
.logs-toolbar {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
}
.logs-toolbar__right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.logs-toolbar__search { width: 200px; }

.logs-table { padding: 0; }
.logs-table__head, .logs-table__row {
  display: grid;
  grid-template-columns: 110px 80px 130px 1fr;
  gap: 12px;
  padding: 10px 14px;
  align-items: center;
}
.logs-table__head {
  font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: 0.1em;
  color: var(--grey-500); text-transform: uppercase;
  background: var(--grey-50);
  border-bottom: 1px solid var(--grey-200);
}
.logs-table__row { border-bottom: 1px solid var(--grey-100); font-size: 12.5px; }
.logs-table__row:last-child { border-bottom: 0; }
.logs-table__ts code, .logs-table__src code {
  font-family: var(--font-mono); font-size: 11.5px; color: var(--grey-700);
}
.logs-table__msg { color: var(--fg); }

/* ─── Schedules ─── */
.sched-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.sched-card__head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
.sched-card__icon {
  width: 36px; height: 36px; border-radius: 9px;
  background: var(--purple-50); color: var(--purple-600);
  display: grid; place-items: center; flex-shrink: 0;
}
.sched-card__main { flex: 1; min-width: 0; }
.sched-card__name { font-size: 14px; font-weight: var(--weight-bold); margin-bottom: 4px; }
.sched-card__meta {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
  padding: 10px; background: var(--grey-50); border-radius: 8px;
  font-size: var(--text-sm);
  margin-bottom: 8px;
}
.sched-card__actions { display: flex; gap: 4px; }
.sched-card__trash { margin-left: auto; }

/* Schedule toggle: green track for "active", grey for "paused" */
.sched-card__head .toggle-wrap input:checked + .toggle-track {
  background: var(--color-success);
}

.sched-card__chip--running {
  animation: pulse-running 1.5s ease-in-out infinite;
}
@keyframes pulse-running {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.sched-health-bar {
  display: flex;
  gap: 4px;
  align-items: center;
}
.sched-health-dot {
  display: inline-block;
  transition: transform 0.15s ease;
}
.sched-health-dot:hover {
  transform: scale(1.5);
}

/* ─── Devices ─── */
.devices-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.device-card__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.device-card__icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: grid; place-items: center;
}
.device-card__icon--edge   { background: var(--purple-50); color: var(--purple-600); }
.device-card__icon--host   { background: rgba(0,114,245,0.1); color: #0058c4; }
.device-card__icon--sensor { background: rgba(255,149,0,0.12); color: #a47000; }
.device-card--offline .device-card__icon { background: var(--grey-100); color: var(--grey-500); }

.device-card__name { font-size: 14px; font-weight: var(--weight-bold); margin-bottom: 6px; }
.device-card__meta { display: flex; gap: 6px; font-size: 11px; }
.device-card__actions { display: flex; gap: 4px; }
.device-card--offline { opacity: 0.7; }

.giap-status-dot {
  width: 6px; height: 6px; border-radius: 50%; display: inline-block;
  margin-right: 4px;
}
.giap-status-dot--online { background: var(--color-success); box-shadow: 0 0 0 2px rgba(52, 199, 89, 0.2); }
.giap-status-dot--offline { background: var(--grey-400); }

/* ─── Prompts ─── */
.prompt-tabs {
  padding: 6px; background: var(--grey-100); border-radius: 12px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  width: 100%;
}
.prompt-tab {
  width: 100%;
  min-width: 0;
  height: auto;
  white-space: normal;
  background-color: transparent;
  background-image: none;
  color: var(--fg);
  box-shadow: none;
  border-radius: 8px;
  position: relative;
  padding: 8px 10px;
  transition: background-color 0.15s;
  cursor: pointer;
  border: none;
  text-align: left;
  font-family: var(--font-body);
}
.prompt-tab:hover { background-color: rgba(140, 75, 255, 0.06); }
.prompt-tab.is-active {
  background-color: var(--bg-brand-soft);
  color: var(--fg-brand);
}
.prompt-tab.is-active::after {
  content: '';
  position: absolute;
  left: 14px; right: 14px; bottom: 2px;
  height: 2px; border-radius: 2px;
  background: var(--bg-brand);
}
.prompt-tab__title {
  display: flex; flex-direction: column; align-items: flex-start;
  width: 100%;
  gap: 2px;
}
.prompt-tab__title > span:first-child { font-size: var(--text-base); font-weight: var(--weight-bold); color: inherit; }
.prompt-tab__desc {
  font-size: 10.5px; color: var(--grey-500); font-weight: var(--weight-regular);
  letter-spacing: 0;
  line-height: 1.35;
  white-space: normal;
  text-align: left;
}
.prompt-tab.is-active .prompt-tab__desc { color: var(--grey-600); }
.prompt-area {
  font-family: var(--font-mono);
  font-size: 12.5px;
  line-height: 1.55;
}
.prompt-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 10px;
}
.prompt-foot__tokens {
  display: flex; align-items: center; gap: 6px;
  font-size: var(--text-sm); color: var(--grey-500);
}
.prompt-foot__actions { display: flex; gap: 6px; }
.var-grid { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }

/* ─── Settings ─── */
.settings-tabs { padding: 0; }

.settings-body { display: flex; flex-direction: column; gap: 14px; margin-top: 4px; }
.section__title {
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  margin: 0 0 14px;
  color: var(--fg);
}
.section__rows { display: flex; flex-direction: column; gap: 14px; }

.settings-row {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 24px;
  align-items: flex-start;
}
.settings-row__label { padding-top: 6px; }
.settings-row__name { font-size: var(--text-base); font-weight: var(--weight-semibold); }
.settings-row__hint { font-size: 11.5px; color: var(--grey-500); margin-top: 2px; line-height: 1.4; }

.shortcut-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.slider-control { max-width: 360px; }

.model-picker { display: flex; align-items: center; gap: 8px; }
.model-picker__current { flex: 1; }

.ext-list { display: flex; flex-direction: column; gap: 8px; }
.ext-row {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border: 1px solid var(--grey-200);
  border-radius: 10px;
}
.ext-row__icon {
  width: 28px; height: 28px; border-radius: 8px;
  background: var(--purple-50); color: var(--purple-600);
  display: grid; place-items: center;
}
.ext-row__name { font-size: var(--text-base); font-weight: var(--weight-semibold); }
.ext-row__meta { display: flex; gap: 6px; margin-top: 2px; }

/* ─── Extensions ─── */

.ext-list-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.ext-card {
  border-bottom: 1px solid var(--grey-100);
  transition: background var(--transition-fast);
}
.ext-card:last-child { border-bottom: none; }
.ext-card--disabled { opacity: 0.65; }
.ext-card:hover { background: var(--grey-50); }

.ext-card__header {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 12px 4px;
}

.ext-card__icon {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: var(--purple-50);
  color: var(--purple-600);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.ext-card__info { min-width: 0; }

.ext-card__title-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.ext-card__name {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--fg);
}

.ext-card__kind-badge {
  font-size: 9px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.04em;
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  font-family: var(--font-mono);
}
.ext-card__kind-badge--stdio {
  background: rgba(0,114,245,0.08);
  color: #0058c4;
  border: 1px solid rgba(0,114,245,0.15);
}
.ext-card__kind-badge--http {
  background: rgba(255,149,0,0.08);
  color: #a47000;
  border: 1px solid rgba(255,149,0,0.2);
}

.ext-card__tool-count {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--grey-400);
  font-weight: var(--weight-regular);
}

.ext-card__desc {
  font-size: var(--text-sm);
  color: var(--grey-500);
  margin-top: 2px;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ext-card__actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.ext-card__expand-btn {
  display: grid;
  place-items: center;
  width: 26px; height: 26px;
  border: 1px solid var(--grey-200);
  border-radius: 6px;
  background: transparent;
  color: var(--grey-500);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.ext-card__expand-btn:hover { background: var(--grey-100); color: var(--fg); }

.ext-card__delete-btn {
  display: grid;
  place-items: center;
  width: 26px; height: 26px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.ext-card__delete-btn:hover:not(:disabled) { background: rgba(255,59,48,0.08); color: var(--color-destructive); }
.ext-card__delete-btn:disabled { cursor: not-allowed; opacity: 0.4; }

.ext-card__tools {
  padding: 0 4px 12px 44px;
}

.ext-card__tools-header {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--grey-400);
  margin-bottom: 6px;
}

.ext-card__tool-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.ext-card__tool-item {
  padding: 4px 8px;
  background: var(--grey-50);
  border: 1px solid var(--grey-100);
  border-radius: 6px;
  font-size: 11.5px;
}
.ext-card__tool-item code {
  font-family: var(--font-mono);
  color: var(--fg);
}

/* Extension status dot */
.ext-card__status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  display: inline-block;
}
.ext-card__status-dot--connected {
  background: var(--color-success);
}
.ext-card__status-dot--loading {
  background: var(--color-warning);
  animation: ext-status-pulse 1.4s ease-in-out infinite;
}
.ext-card__status-dot--error {
  background: var(--color-destructive);
}
.ext-card__status-dot--disabled {
  background: var(--grey-300);
}

@keyframes ext-status-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.35; }
}

/* Extension error line */
.ext-card__error-line {
  font-size: var(--text-sm);
  color: var(--color-destructive);
  margin-top: 3px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* Add Extension accordion */

.ext-add-accordion {
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card);
  overflow: hidden;
  background: #fff;
}

.ext-add-accordion__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 12px 16px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--grey-600);
  font-family: var(--font-body);
  font-size: var(--text-base);
  transition: background var(--transition-fast);
}
.ext-add-accordion__trigger:hover { background: var(--grey-50); }

.ext-add-accordion__trigger-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-weight: var(--weight-semibold);
}

.ext-add-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 16px;
  border-top: 1px solid var(--grey-100);
  background: var(--grey-50);
}

.ext-form-row {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 16px;
  align-items: center;
}

.ext-form-label {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--fg);
}

.ext-form-hint {
  font-size: 11px;
  font-weight: var(--weight-regular);
  color: var(--grey-400);
}

.ext-form-required {
  color: var(--color-destructive);
  margin-left: 2px;
}

.ext-form-input,
.ext-form-select {
  height: 34px;
  padding: 0 10px;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-family: var(--font-body);
  background: #fff;
  color: var(--fg);
  outline: none;
  transition: border-color var(--transition-fast);
  width: 100%;
  box-sizing: border-box;
}
.ext-form-input:focus,
.ext-form-select:focus { border-color: var(--color-accent); }
.ext-form-input:disabled,
.ext-form-select:disabled { opacity: 0.5; cursor: not-allowed; }

.ext-form-select { cursor: pointer; appearance: auto; }

.ext-form-error {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--color-destructive);
  padding: 6px 10px;
  background: rgba(255,59,48,0.06);
  border: 1px solid rgba(255,59,48,0.15);
  border-radius: var(--radius-sm);
}

.ext-form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 2px;
}

/* ─── Extensions: Tab Bar ─── */

.ext-tab-bar {
  display: flex;
  gap: 0;
  border-bottom: 2px solid var(--grey-100);
  margin-bottom: 2px;
}

.ext-tab-bar__tab {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 4px;
  margin-right: 20px;
  border: none;
  background: transparent;
  color: var(--grey-500);
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  cursor: pointer;
  position: relative;
  transition: color var(--transition-fast);
  white-space: nowrap;
}

.ext-tab-bar__tab:hover {
  color: var(--fg);
}

.ext-tab-bar__tab--active {
  color: var(--color-accent);
  font-weight: var(--weight-semibold);
}

.ext-tab-bar__tab--active::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--color-accent);
  border-radius: 2px 2px 0 0;
}

.ext-tab-bar__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: var(--grey-100);
  color: var(--grey-600);
  font-size: 10px;
  font-weight: var(--weight-semibold);
  font-family: var(--font-mono);
}

.ext-tab-bar__tab--active .ext-tab-bar__count {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

/* ─── Extensions: Inline link ─── */

.ext-inline-link {
  background: none;
  border: none;
  padding: 0;
  color: var(--color-accent);
  font-family: var(--font-body);
  font-size: inherit;
  font-weight: var(--weight-semibold);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.ext-inline-link:hover {
  color: var(--color-accent-hover);
}

/* ─── Extensions: Marketplace Grid ─── */

.mkt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

@media (max-width: 580px) {
  .mkt-grid { grid-template-columns: 1fr; }
}

/* ─── Extensions: Marketplace Card ─── */

.mkt-card {
  border: 1px solid var(--grey-150, var(--grey-200));
  border-radius: var(--radius-card, 10px);
  padding: 12px;
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  position: relative;
  overflow: hidden;
}

.mkt-card:hover {
  border-color: var(--grey-300, #d0d0d8);
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.mkt-card--featured {
  border-color: var(--purple-200, #CFB0FF);
  background: linear-gradient(135deg, var(--purple-50, #F4ECFF) 0%, #fff 60%);
}

.mkt-card--featured:hover {
  border-color: var(--purple-400, #9D63FF);
  box-shadow: 0 2px 10px rgba(140, 75, 255, 0.12);
}

.mkt-card__featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 9px;
  font-weight: var(--weight-bold);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--purple-600, #7636E6);
  padding: 2px 6px;
  background: var(--purple-50, #F4ECFF);
  border: 1px solid var(--purple-200, #CFB0FF);
  border-radius: 4px;
  align-self: flex-start;
}

.mkt-card__header {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: flex-start;
  gap: 10px;
}

.mkt-card__icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: var(--purple-50, #F4ECFF);
  color: var(--purple-600, #7636E6);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.mkt-card--featured .mkt-card__icon {
  background: var(--purple-100, #E6D6FF);
}

.mkt-card__info {
  min-width: 0;
}

.mkt-card__name {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mkt-card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 3px;
  flex-wrap: wrap;
}

.mkt-card__category-badge {
  font-size: 9px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.04em;
  text-transform: capitalize;
  padding: 1px 6px;
  border-radius: var(--radius-sm, 4px);
  background: rgba(0, 122, 255, 0.08);
  color: #0058c4;
  border: 1px solid rgba(0, 122, 255, 0.14);
  white-space: nowrap;
}

.mkt-card__tool-count {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--grey-400);
}

.mkt-card__action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* Install button */
.mkt-card__install-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 28px;
  padding: 0 10px;
  border: 1px solid var(--color-accent);
  border-radius: 7px;
  background: transparent;
  color: var(--color-accent);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
  white-space: nowrap;
}

.mkt-card__install-btn:hover:not(:disabled) {
  background: var(--color-accent);
  color: #fff;
}

.mkt-card__install-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.mkt-card__install-spinner {
  width: 11px;
  height: 11px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: mkt-spin 0.7s linear infinite;
  flex-shrink: 0;
}

@keyframes mkt-spin {
  to { transform: rotate(360deg); }
}

/* Installed badge */
.mkt-card__installed-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 28px;
  padding: 0 10px;
  border-radius: 7px;
  background: var(--color-success-soft, rgba(52, 199, 89, 0.12));
  color: var(--color-success, #34C759);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  border: 1px solid rgba(52, 199, 89, 0.2);
  white-space: nowrap;
}

/* Description */
.mkt-card__desc {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--grey-500);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Footer */
.mkt-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 2px;
}

.mkt-card__author {
  font-size: 10px;
  color: var(--grey-400);
  font-weight: var(--weight-regular);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mkt-card__kind-badge {
  font-size: 9px;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.04em;
  padding: 1px 6px;
  border-radius: var(--radius-sm, 4px);
  white-space: nowrap;
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.mkt-card__kind-badge--stdio {
  background: rgba(0,114,245,0.08);
  color: #0058c4;
  border: 1px solid rgba(0,114,245,0.15);
}

.mkt-card__kind-badge--http {
  background: rgba(255,149,0,0.08);
  color: #a47000;
  border: 1px solid rgba(255,149,0,0.2);
}

/* ─── Extensions: Marketplace Loading / Error ─── */

.mkt-loading {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 20px 0;
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
}

.mkt-loading__spinner {
  width: 16px;
  height: 16px;
  border: 2px solid var(--grey-200);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: mkt-spin 0.8s linear infinite;
  flex-shrink: 0;
}

.mkt-error {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  font-size: var(--text-sm);
  color: var(--color-destructive);
  background: var(--color-destructive-soft);
  border: 1px solid rgba(255, 59, 48, 0.15);
  border-radius: var(--radius-md, 8px);
}

/* ─── Secret Config Modal ─── */

.secret-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(23, 22, 22, 0.45);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: secret-modal-fade-in 160ms ease-out;
}

@keyframes secret-modal-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.secret-modal {
  background: #fff;
  border-radius: var(--radius-xl);
  border: 1px solid var(--grey-200);
  box-shadow: var(--shadow-lg), 0 0 0 1px rgba(23,22,22,0.03);
  width: 100%;
  max-width: 420px;
  display: flex;
  flex-direction: column;
  gap: 0;
  animation: secret-modal-slide-in 180ms var(--ease-out);
  overflow: hidden;
}

@keyframes secret-modal-slide-in {
  from { opacity: 0; transform: translateY(10px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.secret-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 18px 14px;
  border-bottom: 1px solid var(--grey-100);
}

.secret-modal__header-left {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
}

.secret-modal__icon {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: var(--purple-50);
  color: var(--purple-600);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  margin-top: 1px;
}

.secret-modal__title-group {
  min-width: 0;
}

.secret-modal__title {
  font-family: var(--font-heading);
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  color: var(--fg);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.secret-modal__subtitle {
  font-size: var(--text-sm);
  color: var(--grey-500);
  margin: 2px 0 0;
  line-height: 1.4;
}

.secret-modal__close {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: none;
  border-radius: 7px;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  flex-shrink: 0;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.secret-modal__close:hover {
  background: var(--grey-100);
  color: var(--fg);
}

.secret-modal__body {
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-height: 60vh;
  overflow-y: auto;
}

.secret-modal__body::-webkit-scrollbar { width: 6px; }
.secret-modal__body::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 4px; }

.secret-modal__section-label {
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--grey-400);
  margin: 0 0 8px;
}

.secret-modal__field {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.secret-modal__field-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--fg);
}

.secret-modal__required-badge {
  font-size: 9px;
  font-weight: var(--weight-bold);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 1px 5px;
  border-radius: 4px;
  background: rgba(140, 75, 255, 0.10);
  color: var(--purple-600);
  border: 1px solid rgba(140, 75, 255, 0.18);
}

.secret-modal__input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.secret-modal__input {
  width: 100%;
  height: 36px;
  padding: 0 36px 0 10px;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-md);
  background: var(--grey-50);
  font-size: var(--text-sm);
  font-family: var(--font-body);
  color: var(--fg);
  outline: none;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.secret-modal__input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(140, 75, 255, 0.12);
  background: #fff;
}

.secret-modal__input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.secret-modal__input--fulfilled {
  border-color: rgba(52, 199, 89, 0.35);
  background: rgba(52, 199, 89, 0.04);
}

.secret-modal__input-toggle {
  position: absolute;
  right: 8px;
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border: none;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  border-radius: 4px;
  transition: color var(--transition-fast);
  padding: 0;
}

.secret-modal__input-toggle:hover { color: var(--fg); }

.secret-modal__field-hint {
  font-size: var(--text-sm);
  color: var(--grey-500);
  line-height: 1.4;
  margin: 0;
}

.secret-modal__field-error {
  font-size: var(--text-sm);
  color: var(--color-destructive);
  margin: 0;
}

.secret-modal__fulfilled-indicator {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--text-sm);
  color: var(--color-success);
  font-weight: var(--weight-medium);
}

/* OAuth block */
.secret-modal__oauth-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px;
  border-radius: var(--radius-md);
  background: var(--grey-50);
  border: 1px solid var(--grey-200);
}

.secret-modal__oauth-desc {
  font-size: var(--text-sm);
  color: var(--grey-600);
  line-height: 1.5;
  margin: 0;
}

.secret-modal__oauth-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  height: 36px;
  padding: 0 14px;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--color-accent);
  background: transparent;
  color: var(--color-accent);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
  white-space: nowrap;
  align-self: flex-start;
}

.secret-modal__oauth-btn:hover:not(:disabled) {
  background: var(--color-accent);
  color: #fff;
}

.secret-modal__oauth-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.secret-modal__oauth-btn--success {
  border-color: var(--color-success);
  color: var(--color-success);
}

.secret-modal__oauth-btn--success:hover:not(:disabled) {
  background: var(--color-success);
  color: #fff;
}

.secret-modal__oauth-polling {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: var(--text-sm);
  color: var(--grey-500);
}

.secret-modal__oauth-spinner {
  width: 12px;
  height: 12px;
  border: 2px solid var(--grey-300);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: mkt-spin 0.75s linear infinite;
  flex-shrink: 0;
}

.secret-modal__divider {
  border: none;
  border-top: 1px solid var(--grey-100);
  margin: 2px 0;
}

.secret-modal__global-error {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  background: var(--color-destructive-soft);
  border: 1px solid rgba(255, 59, 48, 0.15);
  font-size: var(--text-sm);
  color: var(--color-destructive);
  line-height: 1.4;
}

.secret-modal__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 18px 16px;
  border-top: 1px solid var(--grey-100);
}

.secret-modal__cancel-btn {
  height: 32px;
  padding: 0 14px;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--grey-600);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.secret-modal__cancel-btn:hover { background: var(--grey-100); color: var(--fg); }

.secret-modal__save-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 16px;
  border: none;
  border-radius: var(--radius-md);
  background: var(--color-accent);
  color: #fff;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  cursor: pointer;
  transition: background var(--transition-fast), opacity var(--transition-fast);
}

.secret-modal__save-btn:hover:not(:disabled) { background: var(--color-accent-hover); }
.secret-modal__save-btn:disabled { opacity: 0.55; cursor: not-allowed; }

.secret-modal__save-spinner {
  width: 11px;
  height: 11px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: mkt-spin 0.7s linear infinite;
  flex-shrink: 0;
}

/* Key icon button for installed extensions with secrets */
.ext-card__secrets-btn {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border: 1px solid var(--grey-200);
  border-radius: 6px;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}

.ext-card__secrets-btn:hover {
  background: var(--purple-50);
  color: var(--purple-600);
  border-color: var(--purple-200);
}

/* Auth status badges on ExtensionCard */
.ext-card__auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  font-weight: var(--weight-semibold);
  padding: 1px 7px;
  border-radius: 20px;
  white-space: nowrap;
  letter-spacing: 0.01em;
  border: 1px solid transparent;
  cursor: default;
  text-decoration: none;
}

.ext-card__auth-badge--ok {
  background: rgba(52, 199, 89, 0.10);
  color: #1a8a3a;
  border-color: rgba(52, 199, 89, 0.25);
}

.ext-card__auth-badge--warn {
  background: rgba(255, 159, 10, 0.10);
  color: #a05f00;
  border-color: rgba(255, 159, 10, 0.25);
  cursor: pointer;
  transition: background var(--transition-fast), border-color var(--transition-fast);
}

.ext-card__auth-badge--warn:hover {
  background: rgba(255, 159, 10, 0.18);
  border-color: rgba(255, 159, 10, 0.45);
}

/* Reconnecting banner shown in SecretConfigModal footer area */
.secret-modal__reconnect-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 18px;
  border-top: 1px solid var(--grey-100);
  font-size: var(--text-sm);
  color: var(--grey-600);
  font-weight: var(--weight-medium);
}

/* Reconnecting state inside OAuthBlock */
.secret-modal__reconnecting {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: var(--text-sm);
  color: var(--grey-500);
}

/* ─── Agent ─── */
.agent-tabs { background: var(--grey-100); border-radius: 12px; padding: 4px; }
.agent-tab { font-weight: var(--weight-semibold); }

.agent-chat-card { min-height: 420px; display: flex; flex-direction: column; }
.agent-chat-card__composer {
  display: flex; gap: 8px; margin-top: auto; padding-top: 16px;
}

.tool-row, .extra-row {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 10px;
}
.tool-row + .tool-row, .extra-row + .extra-row { border-top: 1px solid var(--grey-100); border-radius: 0; }
.tool-row__icon { color: var(--purple-600); }
.tool-row__name { font-size: var(--text-base); font-family: var(--font-mono); font-weight: var(--weight-medium); }
.tool-row__spacer { flex: 1; }

.extras-add { display: flex; gap: 8px; }
.extras-add > div:first-child { flex: 1; }

.extra-row { font-size: var(--text-base); color: var(--fg); }

/* ─── Canvas ─── */
.screen--canvas {
  max-width: none;
  height: calc(100vh - 80px);
  gap: 0;
}

.canvas-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 0 14px;
  border-bottom: 1px solid var(--grey-200);
  margin-bottom: 14px;
}
.canvas-toolbar__left { display: flex; align-items: center; gap: 10px; }
.canvas-toolbar__right { display: flex; align-items: center; gap: 8px; }

/* ── Stage: full-bleed canvas with floating chat dock ── */
.canvas-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
}
.canvas-stage > .canvas-pane { flex: 1; min-width: 0; }

/* Floating chat dock */
.chat-dock {
  position: absolute;
  top: 12px; left: 12px; bottom: 12px;
  width: 380px;
  display: flex; flex-direction: column;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid rgba(28, 28, 28, 0.06);
  border-radius: var(--radius-card);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.6),
    0 1px 2px rgba(0,0,0,0.04),
    0 12px 40px rgba(28,28,28,0.10);
  overflow: hidden;
  z-index: 10;
  transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.chat-dock.is-collapsed {
  width: auto;
  bottom: auto;
  background: rgba(255,255,255,0.7);
}
.chat-dock__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 12px;
  border-bottom: 1px solid rgba(28,28,28,0.06);
  flex-shrink: 0;
  background: rgba(255,255,255,0.25);
}
.chat-dock__title {
  display: flex; align-items: center; gap: 8px;
  font-size: var(--text-base); font-weight: var(--weight-semibold); color: var(--fg);
}
.chat-dock__subtitle {
  font-size: 10.5px; font-weight: var(--weight-medium);
  text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--grey-500);
  padding: 2px 6px; border-radius: 4px;
  background: var(--grey-100);
}
.chat-dock__icon-btn {
  width: 26px; height: 26px;
  display: grid; place-items: center;
  border: 0; background: transparent; cursor: pointer;
  border-radius: 6px;
  color: var(--grey-600);
  transition: background 0.12s;
}
.chat-dock__icon-btn:hover { background: var(--grey-100); color: var(--fg); }
.chat-dock__body {
  flex: 1;
  overflow-y: auto;
  padding: 14px;
  display: flex; flex-direction: column; gap: 10px;
}
.chat-dock__body::-webkit-scrollbar { width: 6px; }
.chat-dock__body::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 6px; }

.chat-dock__pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 12px 8px 8px;
  border: 0; background: transparent; cursor: pointer;
  font: inherit; font-size: 12.5px; font-weight: var(--weight-semibold);
  color: var(--fg);
}
.chat-dock__count {
  font-size: 10.5px; font-weight: var(--weight-semibold);
  padding: 1px 6px; border-radius: var(--radius-pill);
  background: var(--bg-brand-soft); color: var(--fg-brand);
  font-variant-numeric: tabular-nums;
}

/* Voice mode UI inside dock */
.voice-bar {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  padding: 18px 14px 22px;
  border-top: 1px solid rgba(28,28,28,0.06);
  background: linear-gradient(180deg, transparent, rgba(140,75,255,0.06));
}
.voice-orb {
  position: relative;
  width: 64px; height: 64px;
  border: 0; border-radius: 50%; cursor: pointer;
  background: linear-gradient(135deg, #CFB0FF 0%, #8C4BFF 100%);
  color: #fff;
  display: grid; place-items: center;
  box-shadow: 0 6px 20px rgba(140, 75, 255, 0.35);
  transition: transform 0.15s;
}
.voice-orb:hover { transform: scale(1.05); }
.voice-orb__ring {
  position: absolute; inset: -4px;
  border-radius: 50%;
  border: 2px solid rgba(140, 75, 255, 0.4);
  opacity: 0;
}
.voice-orb.is-active .voice-orb__ring {
  animation: voicePulse 1.6s ease-out infinite;
}
.voice-orb.is-active .voice-orb__ring--2 {
  animation-delay: 0.6s;
}
@keyframes voicePulse {
  0%   { transform: scale(0.9); opacity: 0.8; }
  100% { transform: scale(1.7); opacity: 0; }
}
.voice-bar__caption {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--grey-600);
}

/* Canvas grid — 2-col when wide */
.canvas-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
@media (max-width: 1100px) {
  .canvas-grid { grid-template-columns: 1fr; }
}

/* ── Canvas pane ── */
.canvas-pane {
  display: flex; flex-direction: column;
  background:
    radial-gradient(800px 600px at 20% 0%, rgba(140,75,255,0.05), transparent 60%),
    var(--grey-50);
  border: 1px solid var(--grey-200);
  border-radius: 12px;
  overflow: hidden;
  min-height: 0;
  position: relative;
}
.canvas-pane::before {
  content: '';
  position: absolute; inset: 40px 0 0 0;
  background-image:
    radial-gradient(circle, var(--grey-300) 1px, transparent 1px);
  background-size: 18px 18px;
  opacity: 0.35;
  pointer-events: none;
}
.canvas-pane__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px;
  border-bottom: 1px solid var(--grey-200);
  background: #fff;
  position: relative; z-index: 1;
}
.canvas-pane__title {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--fg);
}
.canvas-pane__hint {
  font-size: 11px; color: var(--grey-500);
}
.canvas-pane__body {
  flex: 1;
  overflow-y: auto;
  padding: 18px;
  display: flex; flex-direction: column; gap: 14px;
  position: relative; z-index: 1;
}

.canvas-empty {
  margin: auto;
  text-align: center;
  max-width: 320px;
  color: var(--grey-500);
}
.canvas-empty__icon {
  width: 64px; height: 64px;
  border-radius: 16px;
  background: #fff; border: 1px solid var(--grey-200);
  display: grid; place-items: center;
  margin: 0 auto 14px;
  color: var(--bg-brand);
}
.canvas-empty__title { font-size: 14px; font-weight: var(--weight-semibold); color: var(--fg); margin-bottom: 4px; }
.canvas-empty__sub { font-size: 12.5px; line-height: 1.5; }

/* MCP-UI card chrome */
.canvas-card {
  background: #fff;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 8px 24px rgba(28,28,28,0.06);
  animation: cardIn 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}
@keyframes cardIn {
  from { opacity: 0; transform: translateY(8px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.canvas-card__chrome {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6px 10px;
  background: var(--grey-50);
  border-bottom: 1px solid var(--grey-200);
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--grey-600);
}
.canvas-card__chrome-left { display: inline-flex; align-items: center; gap: 6px; color: var(--bg-brand); }
.canvas-card__chrome code { font-size: 10.5px; color: var(--bg-brand); }
.canvas-card__close {
  border: 0; background: transparent; cursor: pointer;
  width: 18px; height: 18px; border-radius: 5px;
  display: grid; place-items: center;
  color: var(--grey-500); font-size: 16px; line-height: 1;
}
.canvas-card__close:hover { background: var(--grey-200); color: var(--fg); }

.canvas-suggest {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  padding: 8px 12px;
  border-top: 1px solid var(--grey-200);
  background: var(--grey-50);
}
.canvas-suggest__label {
  font-size: 10.5px; font-weight: var(--weight-semibold); letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--grey-500);
  margin-right: 2px;
}
.canvas-suggest__chip {
  font: inherit;
  font-size: 11.5px; font-weight: var(--weight-medium);
  padding: 4px 10px; border-radius: var(--radius-pill);
  background: #fff;
  border: 1px solid var(--grey-200);
  color: var(--grey-700);
  cursor: pointer;
  transition: all 0.15s;
}
.canvas-suggest__chip:hover {
  border-color: var(--bg-brand);
  color: var(--bg-brand);
  background: var(--bg-brand-soft);
}

.canvas-composer {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 12px;
  border-top: 1px solid rgba(28,28,28,0.06);
  background: rgba(255,255,255,0.25);
}
.canvas-composer__input {
  flex: 1;
  border: 1px solid rgba(28,28,28,0.08);
  background: rgba(255,255,255,0.7);
  border-radius: 10px;
  padding: 8px 12px;
  font: inherit;
  font-size: var(--text-base);
  color: var(--fg);
  outline: none;
  transition: border-color 0.15s;
}
.canvas-composer__input:focus { border-color: var(--bg-brand); }

/* Tool call chips (inside canvas chat) */
.tool-call {
  display: inline-flex; align-items: center; gap: 6px;
  align-self: flex-start;
  padding: 5px 9px;
  border-radius: 8px;
  background: var(--grey-50);
  border: 1px dashed var(--grey-300);
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--grey-700);
}
.tool-call code { font-size: 11px; color: var(--fg-brand); }
.tool-call--ok { border-style: solid; border-color: rgba(52, 199, 89, 0.3); background: rgba(52, 199, 89, 0.05); }
.tool-call--running { border-color: var(--purple-500); background: rgba(140,75,255,0.06); }
.tool-call__status { color: var(--grey-500); font-size: 10.5px; margin-left: 2px; }

/* ─── Tool call chips — chat bubble inline indicators ─── */
.tool-call-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 6px;
}

/* Chip variant: interactive, shows expand chevron */
.tool-call--chip {
  cursor: pointer;
  user-select: none;
  transition: background 120ms ease, border-color 120ms ease;
  /* Override the inline-flex from .tool-call so the expanded result
     can stretch full-width below the chip row */
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 100%;
}
.tool-call--chip > *:not(.tool-call-result) {
  /* Keep the icon + name + chevron on one row */
  display: flex;
  align-items: center;
  gap: 6px;
}
/* Re-establish top-row layout for chip children */
.tool-call--chip {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.tool-call--chip.tool-call--expanded {
  flex-direction: column;
  align-items: flex-start;
}
.tool-call--chip .tool-call__name {
  font-size: 11px;
  line-height: 1;
}

.tool-call--chip:hover {
  background: var(--grey-100);
  border-color: var(--grey-400);
}
.tool-call--chip:focus-visible {
  outline: 2px solid var(--fg-brand);
  outline-offset: 1px;
}

/* Expanded result panel */
.tool-call-result {
  margin-top: 6px;
  padding: 7px 10px;
  background: var(--grey-50);
  border-radius: 6px;
  border: 1px solid var(--grey-200);
  font-size: 11.5px;
  font-family: var(--font-body);
  color: var(--grey-700);
  max-height: 120px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
  width: 100%;
  box-sizing: border-box;
}

/* ─── HeroUI compound Tabs overrides ─── */
[role="tablist"] {
  display: flex; gap: 2px;
}
[role="tab"] {
  padding: 6px 16px;
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--grey-600);
  cursor: pointer;
  border: none; background: transparent;
  border-radius: 8px;
  transition: background 120ms, color 120ms;
  position: relative;
  white-space: nowrap;
}
[role="tab"]:hover { background: var(--grey-100); color: var(--fg); }
[role="tab"][aria-selected="true"] {
  color: var(--purple-700);
  font-weight: var(--weight-semibold);
}
/* Hide HeroUI's built-in tab indicator — we use CSS pseudo-elements instead */
[data-slot="indicator"],
[data-slot="tabs-indicator"] {
  display: none !important;
}
/* Segmented/solid variant (agent-tabs, logs toolbar) */
.agent-tabs [role="tablist"],
.logs-toolbar [role="tablist"] {
  background: var(--grey-100); border-radius: 10px; padding: 3px;
}
.agent-tabs [role="tab"][aria-selected="true"],
.logs-toolbar [role="tab"][aria-selected="true"] {
  background: var(--color-accent); color: #fff; border-radius: 7px;
}
/* Settings underlined tabs */
.settings-tabs { border-bottom: 1px solid var(--grey-200); }
.settings-tabs [role="tab"][aria-selected="true"]::after {
  content: ''; position: absolute; bottom: -1px; left: 8px; right: 8px;
  height: 2px; border-radius: 1px;
  background: var(--color-accent);
}
/* Models toolbar tabs */
.models-toolbar__tabs { border-bottom: 1px solid var(--grey-200); }
.models-toolbar__tabs [role="tab"][aria-selected="true"]::after {
  content: ''; position: absolute; bottom: -1px; left: 4px; right: 4px;
  height: 2px; border-radius: 1px;
  background: var(--color-accent);
}

/* ─── Misc ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  gap: 12px;
  color: var(--grey-500);
  text-align: center;
  font-size: var(--text-base);
}
.empty-state--inline { padding: 20px; flex-direction: row; }
.empty-state svg { color: var(--grey-400); }

.muted { color: var(--grey-500); }
.muted-12 { font-size: var(--text-sm); color: var(--grey-500); }

/* ─── Toast notifications ─── */
.toast-container {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 9000;
  display: flex;
  flex-direction: column-reverse;
  gap: 8px;
  pointer-events: none;
}

.toast-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 300px;
  padding: 10px 12px;
  background: #fff;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card, 10px);
  box-shadow: 0 4px 20px rgba(28, 28, 28, 0.12), 0 1px 4px rgba(28, 28, 28, 0.06);
  cursor: pointer;
  pointer-events: all;
  animation: toast-slide-in 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.05);
  transition: opacity 0.2s, transform 0.2s;
}

.toast-card:hover { background: var(--grey-50); }

@keyframes toast-slide-in {
  from {
    opacity: 0;
    transform: translateX(20px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.toast-card__icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.toast-card[data-status="completed"] .toast-card__icon {
  background: rgba(52, 199, 89, 0.12);
  color: var(--color-success, #34c759);
}

.toast-card[data-status="failed"] .toast-card__icon {
  background: rgba(255, 59, 48, 0.10);
  color: var(--color-destructive, #ff3b30);
}

.toast-card[data-status="running"] .toast-card__icon {
  background: rgba(255, 149, 0, 0.12);
  color: var(--color-warning, #FF9500);
}

.toast-card__body {
  flex: 1;
  min-width: 0;
}

.toast-card__title {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: var(--text-sm, 12px);
  font-weight: var(--weight-semibold, 600);
  color: var(--fg, #171616);
  flex-wrap: nowrap;
  overflow: hidden;
}

.toast-card__title span:nth-child(2) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.toast-card__badge {
  font-size: 9px;
  font-weight: var(--weight-bold, 700);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 1px 6px;
  border-radius: var(--radius-pill, 999px);
  white-space: nowrap;
  flex-shrink: 0;
}

.toast-card__badge--completed {
  background: rgba(52, 199, 89, 0.12);
  color: #0e8a4a;
}

.toast-card__badge--failed {
  background: rgba(255, 59, 48, 0.10);
  color: var(--color-destructive, #ff3b30);
}

.toast-card__badge--running {
  background: rgba(255, 149, 0, 0.12);
  color: #cc7700;
}

.toast-card__spinner {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.toast-card__preview {
  margin: 4px 0 0;
  font-size: var(--text-xs, 10px);
  color: var(--grey-500);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.toast-card__close {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border: none;
  border-radius: 5px;
  background: transparent;
  color: var(--grey-400);
  cursor: pointer;
  flex-shrink: 0;
  transition: background var(--transition-fast), color var(--transition-fast);
  margin-top: 1px;
}

.toast-card__close:hover {
  background: var(--grey-100);
  color: var(--fg);
}

/* ─── Schedule Calendar ─── */
.sched-cal {
  display: grid;
  /* time column (56px) + 7 day columns */
  grid-template-columns: 56px repeat(7, 1fr);
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card, 10px);
  overflow: hidden;
  background: #fff;
  font-size: var(--text-xs, 10px);
}

/* Header row */
.sched-cal__header-spacer {
  background: var(--grey-50);
  border-bottom: 1px solid var(--grey-200);
  border-right: 1px solid var(--grey-100);
}

.sched-cal__day-header {
  background: var(--grey-50);
  border-bottom: 1px solid var(--grey-200);
  border-right: 1px solid var(--grey-100);
  padding: 8px 4px;
  text-align: center;
  font-weight: var(--weight-bold, 700);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--grey-500);
}

.sched-cal__day-header:last-child { border-right: none; }
.sched-cal__day-header.is-today {
  color: var(--purple-700);
  background: var(--purple-50);
}

/* Body: the scrollable time grid */
.sched-cal__body {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 56px repeat(7, 1fr);
  max-height: 520px;
  overflow-y: auto;
  position: relative;
}
.sched-cal__body::-webkit-scrollbar { width: 8px; }
.sched-cal__body::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 4px; }

/* Hour row container */
.sched-cal__hour-row {
  display: contents;
}

/* Time label cell */
.sched-cal__time-label {
  grid-column: 1;
  padding: 0 8px;
  height: 48px;
  display: flex;
  align-items: flex-start;
  padding-top: 6px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--grey-400);
  background: var(--grey-50);
  border-right: 1px solid var(--grey-100);
  border-bottom: 1px solid var(--grey-100);
  position: relative;
  z-index: 1;
}

/* Day cell within an hour row */
.sched-cal__cell {
  height: 48px;
  border-right: 1px solid var(--grey-100);
  border-bottom: 1px solid var(--grey-100);
  position: relative;
  padding: 2px;
}

.sched-cal__cell:last-child { border-right: none; }
.sched-cal__cell.is-today { background: rgba(140, 75, 255, 0.02); }

/* Schedule pills */
.sched-cal__pill {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  height: 20px;
  padding: 0 6px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: var(--weight-semibold, 600);
  color: #fff;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  border: none;
  outline: none;
  transition: opacity 0.15s, transform 0.12s;
  position: relative;
  z-index: 2;
}

.sched-cal__pill:hover {
  opacity: 0.85;
  transform: scale(1.03);
}

/* Hourly dot: smaller pill variant */
.sched-cal__dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  cursor: pointer;
  transition: transform 0.12s;
  position: relative;
  z-index: 2;
}

.sched-cal__dot:hover { transform: scale(1.4); }

/* Current-time marker */
.sched-cal__time-marker {
  position: absolute;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--color-destructive, #ff3b30);
  z-index: 5;
  pointer-events: none;
}

.sched-cal__time-marker::before {
  content: '';
  position: absolute;
  left: -4px;
  top: -4px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--color-destructive, #ff3b30);
}

/* Popover */
.sched-cal__popover {
  position: fixed;
  z-index: 200;
  background: #fff;
  border: 1px solid var(--grey-200);
  border-radius: var(--radius-card, 10px);
  box-shadow: 0 8px 28px rgba(28,28,28,0.14), 0 2px 8px rgba(28,28,28,0.06);
  padding: 12px 14px;
  min-width: 220px;
  max-width: 280px;
  font-size: var(--text-sm, 12px);
}

.sched-cal__popover-title {
  font-weight: var(--weight-bold, 700);
  font-size: var(--text-base, 13px);
  color: var(--fg);
  margin-bottom: 6px;
}

.sched-cal__popover-cron {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--grey-600);
  background: var(--grey-100);
  padding: 2px 6px;
  border-radius: 4px;
  margin-bottom: 6px;
  display: inline-block;
}

.sched-cal__popover-freq {
  font-size: 11px;
  color: var(--grey-500);
  margin-bottom: 6px;
}

.sched-cal__popover-result {
  font-size: 11px;
  color: var(--grey-500);
  line-height: 1.4;
  border-top: 1px solid var(--grey-100);
  padding-top: 6px;
  margin-top: 6px;
}

/* View toggle button group in page header */
.view-toggle {
  display: flex;
  gap: 2px;
  border: 1px solid var(--grey-200);
  border-radius: 8px;
  padding: 2px;
  background: var(--grey-50);
}

.view-toggle__btn {
  display: grid;
  place-items: center;
  width: 32px;
  height: 30px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--grey-600);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.view-toggle__btn:hover { background: var(--grey-100); color: var(--fg); }

.view-toggle__btn.is-active {
  background: #fff;
  color: var(--purple-700);
  box-shadow: 0 1px 3px rgba(28,28,28,0.10);
}

/* =============================================================================
   Notifications Panel
   ============================================================================= */

/* ─────────────────────────────────────────────
   Notifications panel — from design styles.css
   ───────────────────────────────────────────── */

.card--notifs {
  background: linear-gradient(135deg, #fefbff 0%, #ffffff 100%) !important;
  border: 1px solid var(--purple-100) !important;
}

.card__label--row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.notif-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: var(--purple-500);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1;
}

.notif-mark-all {
  background: none;
  border: none;
  font: inherit;
  font-size: 11px;
  color: var(--grey-400);
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 4px;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.12s;
}
.notif-mark-all:hover { color: var(--purple-700); }

.notif-expand-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  color: var(--purple-600);
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 4px;
  transition: color 0.12s, background 0.12s;
}
.notif-expand-btn:hover { color: var(--purple-700); background: var(--purple-50); }

.notif-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 48px 0;
  color: var(--grey-400);
  font-size: 13px;
}
.notif-empty svg { color: var(--grey-300); }

.notif-list { display: flex; flex-direction: column; }

.notif-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  transition: background 0.12s;
}
.notif-row + .notif-row { border-top: 1px solid var(--grey-100); }
.notif-row:hover { background: var(--grey-50); }
.notif-row--unread { background: var(--purple-50); }
.notif-row--unread:hover { background: rgba(140, 75, 255, 0.07); }

.notif-row__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--grey-200);
  flex-shrink: 0;
}
.notif-row__dot--active {
  background: var(--purple-500);
  box-shadow: 0 0 0 3px rgba(140, 75, 255, 0.2);
}

.notif-row__icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  background: var(--grey-100);
  color: var(--grey-600);
}
.notif-icon--daily   { background: rgba(251, 191, 36, 0.12); color: #b08000; }
.notif-icon--weekly  { background: rgba(0, 114, 245, 0.1);   color: #0058c4; }
.notif-icon--memory  { background: var(--purple-50);          color: var(--purple-700); }

.notif-row__body { flex: 1; min-width: 0; }
.notif-row__title {
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
  margin-bottom: 2px;
}
.notif-row__excerpt {
  font-size: 11.5px;
  color: var(--grey-500);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notif-row__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
}
.notif-row__ago {
  font-size: 11px;
  color: var(--grey-400);
  white-space: nowrap;
}
.notif-row__cta {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  color: var(--purple-600);
  background: none;
  border: none;
  cursor: pointer;
  padding: 3px 7px;
  border-radius: 5px;
  transition: background 0.12s;
}
.notif-row__cta:hover { background: var(--purple-50); }
.notif-row__cta:disabled { opacity: 0.4; cursor: default; }

/* =============================================================================
   Sidebar Bell Button + Badge
   ============================================================================= */

.sidebar__bell-wrapper {
  padding: 4px 14px 2px;
}

.sidebar__item--bell {
  position: relative;
}

.sidebar__bell-badge {
  position: absolute;
  top: 2px;
  right: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 8px;
  background: var(--purple-500, #8C4BFF);
  color: #fff;
  font-size: 10px;
  font-weight: var(--weight-bold);
  line-height: 1;
  pointer-events: none;
}

/* When sidebar is collapsed, anchor badge to the icon */
.is-collapsed .sidebar__bell-badge {
  top: 0;
  right: 2px;
}

/* =============================================================================
   MCP-UI Card Shell
   ============================================================================= */

.mcp-card {
  background: #fff;
  border: 1px solid var(--grey-200, #EDEDED);
  border-radius: 14px;
  overflow: hidden;
}

.mcp-card__chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: var(--grey-50, #FAFAFA);
  border-bottom: 1px solid var(--grey-100, #F5F5F5);
  font-size: 12px;
}

.mcp-card__chrome-left {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mcp-card__body {
  padding: 0;
}

.mcp-card__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 10px 14px;
  border-top: 1px solid var(--grey-100, #F5F5F5);
}

.mcp-card__close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--grey-500, #8A8A8A);
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
}

.mcp-card__close:hover {
  background: var(--grey-100, #F5F5F5);
  color: var(--grey-700, #3D3D3D);
}

/* =============================================================================
   UI Card types — weather, calendar, news, crypto, smart home, map
   ============================================================================= */

.ui-card {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Weather */
.ui-weather__hero {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 10px;
}

.ui-weather__temp {
  font-size: 42px;
  font-weight: 700;
  line-height: 1;
  font-family: var(--font-heading);
  color: var(--fg);
}

.ui-weather__forecast {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.ui-weather__fday {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 48px;
  padding: 6px 4px;
  border-radius: 8px;
  background: var(--grey-50);
  font-size: 11px;
  color: var(--grey-600);
}

.ui-weather__fday-temp {
  font-weight: 600;
  font-size: 13px;
  color: var(--fg);
}

/* Calendar */
.ui-calendar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 600;
  font-size: 13px;
  color: var(--fg);
  margin-bottom: 8px;
}

.ui-calendar__event {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
  border-bottom: 1px solid var(--grey-100);
  font-size: 13px;
}

.ui-calendar__event:last-child { border-bottom: none; }

.ui-calendar__event-bar {
  width: 3px;
  border-radius: 2px;
  align-self: stretch;
  flex-shrink: 0;
  min-height: 28px;
  background: var(--purple-400, #A855F7);
}

.ui-calendar__event-time {
  font-size: 11px;
  color: var(--grey-500);
  min-width: 60px;
  font-family: var(--font-mono);
}

/* Crypto */
.ui-crypto__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid var(--grey-100);
  font-size: 13px;
}

.ui-crypto__row:last-child { border-bottom: none; }

.ui-crypto__sparkline {
  height: 28px;
  width: 70px;
  flex-shrink: 0;
}

.ui-crypto__change {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-mono);
  min-width: 54px;
  text-align: right;
}

.ui-crypto__change--up { color: var(--color-success, #34C759); }
.ui-crypto__change--down { color: var(--color-danger, #FF3B30); }

/* News */
.ui-news__row {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 0;
  border-bottom: 1px solid var(--grey-100);
  font-size: 13px;
  color: var(--fg);
}

.ui-news__row:last-child { border-bottom: none; }

.ui-news__tag {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 4px;
  background: var(--grey-100);
  color: var(--grey-600);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  align-self: flex-start;
}

.ui-news__headline {
  font-weight: 500;
  line-height: 1.4;
}

.ui-news__source {
  font-size: 11px;
  color: var(--grey-400);
}

/* Smart home */
.ui-home__rooms {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 8px;
}

.ui-home__room {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 10px 8px;
  border-radius: 10px;
  background: var(--grey-50);
  border: 1px solid var(--grey-100);
  font-size: 12px;
  color: var(--grey-600);
  transition: background 150ms;
}

.ui-home__room--on {
  background: var(--purple-50, #F3EFFF);
  border-color: var(--purple-100, #DDD5FF);
  color: var(--purple-700, #5B21B6);
}

.ui-home__sensor {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--grey-500);
}

/* Map */
.ui-map__visual {
  border-radius: 8px;
  overflow: hidden;
  background: var(--grey-100);
  height: 120px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--grey-400);
  font-size: 12px;
}

.ui-map__route {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  font-size: 13px;
  border-bottom: 1px solid var(--grey-100);
}

.ui-map__route:last-child { border-bottom: none; }

.ui-map__route--best {
  background: var(--grey-50);
  border-radius: 6px;
  padding: 6px 8px;
  margin: 0 -8px;
}

.ui-map__best-tag {
  display: inline-block;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--color-success, #34C759);
  color: #fff;
  font-size: 10px;
  font-weight: 600;
}

/* Generic */
.ui-generic__pre {
  font-family: var(--font-mono);
  font-size: 12px;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--fg);
  line-height: 1.6;
  padding: 14px;
  margin: 0;
}

/* =============================================================================
   MCP App Host — iframe-based MCP Apps renderer (standard protocol)
   ============================================================================= */

.mcp-app-host {
  background: #fff;
  border: 1px solid var(--grey-200, #EDEDED);
  border-radius: 14px;
  overflow: hidden;
}
.mcp-app-host__chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: var(--grey-50, #FAFAFA);
  border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.mcp-app-host__label {
  font-size: 12px;
  font-weight: 600;
  color: var(--grey-600, #5F5F5F);
  font-family: var(--font-mono);
}
.mcp-app-host__close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--grey-500, #8A8A8A);
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
}
.mcp-app-host__close:hover {
  background: var(--grey-100, #F5F5F5);
  color: var(--grey-700, #3D3D3D);
}
.mcp-app-host__frame {
  display: block;
  width: 100%;
  min-height: 200px;
}

/* =============================================================================
   Canvas grid — responsive layout for canvas cards
   ============================================================================= */

.canvas-grid--stack {
  grid-template-columns: 1fr;
  max-width: 600px;
}

/* =============================================================================
   MCP-UI Card Inner Classes — layout for card content
   ============================================================================= */

/* ── Weather inner ── */
.ui-weather__icon { flex-shrink: 0; color: #F59E0B; }
.ui-weather__main { display: flex; align-items: baseline; gap: 2px; }
.ui-weather__unit { font-size: 18px; font-weight: 500; color: var(--grey-500, #8A8A8A); }
.ui-weather__info { display: flex; flex-direction: column; gap: 2px; }
.ui-weather__condition { font-size: 14px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-weather__location { font-size: 12px; color: var(--grey-500, #8A8A8A); }
.ui-weather__details {
  display: flex; gap: 16px; padding-top: 10px; margin-top: 4px;
  border-top: 1px solid var(--grey-100, #F5F5F5);
}
.ui-weather__detail {
  display: flex; align-items: center; gap: 5px;
  font-size: 12px; color: var(--grey-600, #5F5F5F);
}
.ui-weather__fday-name { font-weight: 600; font-size: 11px; text-transform: uppercase; }
.ui-weather__fday-temps { font-size: 12px; color: var(--grey-600, #5F5F5F); }
.ui-weather__fday-temps strong { color: var(--fg, #1C1C1C); }

/* ── Calendar inner ── */
.ui-calendar__header-left { display: flex; align-items: center; gap: 8px; }
.ui-calendar__date { font-size: 14px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-calendar__next { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--grey-500, #8A8A8A); }
.ui-calendar__list { display: flex; flex-direction: column; }
.ui-calendar__event-body { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.ui-calendar__event-row { display: flex; align-items: center; gap: 8px; }
.ui-calendar__event-duration {
  font-size: 11px; color: var(--grey-400, #B5B5B5);
  padding: 1px 5px; background: var(--grey-50, #FAFAFA); border-radius: 4px;
}
.ui-calendar__event-title { font-size: 13px; font-weight: 500; color: var(--fg, #1C1C1C); }
.ui-calendar__event-location {
  display: flex; align-items: center; gap: 3px;
  font-size: 11px; color: var(--grey-500, #8A8A8A);
}

/* ── Crypto inner ── */
.ui-crypto__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.ui-crypto__header-left { display: flex; align-items: center; gap: 8px; }
.ui-crypto__title { font-size: 14px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-crypto__live-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #16A34A; display: inline-block;
  animation: pulse-dot 1.5s ease infinite;
}
@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.ui-crypto__list { display: flex; flex-direction: column; }
.ui-crypto__coin-info { display: flex; flex-direction: column; gap: 1px; min-width: 80px; }
.ui-crypto__symbol { font-size: 13px; font-weight: 700; color: var(--fg, #1C1C1C); }
.ui-crypto__name { font-size: 11px; color: var(--grey-500, #8A8A8A); }
.ui-crypto__chart { flex: 1; display: flex; align-items: center; justify-content: center; }
.ui-crypto__price-col { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; min-width: 70px; }
.ui-crypto__price { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); font-family: var(--font-mono); }

/* ── News inner ── */
.ui-news__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.ui-news__header-left { display: flex; align-items: center; gap: 8px; }
.ui-news__title { font-size: 14px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-news__list { display: flex; flex-direction: column; }
.ui-news__row {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5); font-size: 13px;
}
.ui-news__row:last-child { border-bottom: none; }
.ui-news__time { font-size: 11px; color: var(--grey-400, #B5B5B5); white-space: nowrap; }
.ui-news__chevron { color: var(--grey-300, #D9D9D9); flex-shrink: 0; }

/* ── Smart Home inner ── */
.ui-home__header { display: flex; align-items: center; justify-content: space-between; }
.ui-home__header-left { display: flex; align-items: center; gap: 8px; }
.ui-home__title { font-size: 14px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-home__meta { font-size: 12px; color: var(--grey-500, #8A8A8A); }
.ui-home__room { cursor: pointer; align-items: center; text-align: center; }
.ui-home__room-name { font-weight: 500; font-size: 12px; }
.ui-home__room-temp { font-size: 11px; color: var(--grey-400, #B5B5B5); }
.ui-home__sensors {
  display: flex; flex-direction: column; gap: 6px;
  padding-top: 10px; margin-top: 4px;
  border-top: 1px solid var(--grey-100, #F5F5F5);
}
.ui-home__sensor-label { flex: 1; font-size: 12px; color: var(--grey-600, #5F5F5F); }
.ui-home__sensor-state { font-size: 12px; font-weight: 500; }
.ui-home__sensor-state--ok { color: #16A34A; }
.ui-home__sensor-state--warn { color: #F59E0B; }

/* ── Map inner ── */
.ui-map__visual svg { display: block; width: 100%; }
.ui-map__routes { display: flex; flex-direction: column; }
.ui-map__route-left { display: flex; align-items: flex-start; gap: 10px; }
.ui-map__route-name { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); display: flex; align-items: center; gap: 6px; }
.ui-map__route-meta { font-size: 11px; color: var(--grey-500, #8A8A8A); margin-top: 2px; }
.ui-map__route-time { font-size: 14px; font-weight: 700; color: var(--fg, #1C1C1C); font-family: var(--font-mono); white-space: nowrap; }

/* ── Memory inner ── */
.ui-memory__header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.ui-memory__header-title { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); flex: 1; }
.ui-memory__list { display: flex; flex-direction: column; gap: 0; }
.ui-memory__item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.ui-memory__item:last-child { border-bottom: none; }
.ui-memory__importance { width: 3px; border-radius: 2px; align-self: stretch; min-height: 24px; flex-shrink: 0; }
.ui-memory__body { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
.ui-memory__content { font-size: 13px; color: var(--fg, #1C1C1C); line-height: 1.4; }
.ui-memory__meta-row { display: flex; align-items: center; gap: 6px; }
.ui-memory__segment-chip {
  display: inline-block; padding: 1px 6px; border-radius: 4px;
  font-size: 10px; font-weight: 600; text-transform: capitalize; letter-spacing: 0.04em;
}
.ui-memory__meta { font-size: 11px; color: var(--grey-400, #B5B5B5); }
.ui-memory__saved {
  display: flex; align-items: flex-start; gap: 10px; padding: 4px 0;
}
.ui-memory__saved-body { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
.ui-memory__saved-label { font-size: 12px; font-weight: 600; color: #16A34A; }
.ui-memory__saved-content { font-size: 13px; color: var(--fg, #1C1C1C); line-height: 1.4; }
.ui-memory__empty {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 16px 0; color: var(--grey-400, #B5B5B5); font-size: 12px;
}

/* ── Schedule inner ── */
.ui-schedule__section-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--grey-500, #8A8A8A); margin-bottom: 4px;
}
.ui-schedule__list { display: flex; flex-direction: column; }
.ui-schedule__item {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.ui-schedule__item:last-child { border-bottom: none; }
.ui-schedule__item-left { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; }
.ui-schedule__item-right { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.ui-schedule__item-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.ui-schedule__name { font-size: 13px; font-weight: 500; color: var(--fg, #1C1C1C); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ui-schedule__cron { font-family: var(--font-mono); font-size: 11px; color: var(--grey-500, #8A8A8A); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ui-schedule__empty {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 16px 0; color: var(--grey-400, #B5B5B5); font-size: 12px;
}

/* ── Knowledge inner ── */
.ui-knowledge__header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.ui-knowledge__query { font-size: 12px; font-weight: 500; color: var(--grey-600, #5F5F5F); flex: 1; }
.ui-knowledge__title { font-size: 16px; font-weight: 700; color: var(--fg, #1C1C1C); margin: 0 0 8px; line-height: 1.3; }
.ui-knowledge__summary { font-size: 13px; line-height: 1.6; color: var(--grey-700, #3D3D3D); margin: 0 0 10px; }
.ui-knowledge__source {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 11px; color: #0072F5; text-decoration: none;
  padding: 3px 8px; background: #EFF6FF; border-radius: 6px;
}
.ui-knowledge__source:hover { background: #DBEAFE; }
.ui-knowledge__results { display: flex; flex-direction: column; gap: 0; }
.ui-knowledge__result {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.ui-knowledge__result:last-child { border-bottom: none; }
.ui-knowledge__result-num {
  width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
  background: var(--grey-100, #F5F5F5); font-size: 11px; font-weight: 600;
  color: var(--grey-500, #8A8A8A); display: flex; align-items: center; justify-content: center;
  margin-top: 1px;
}
.ui-knowledge__result-body { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
.ui-knowledge__result-title { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); }
.ui-knowledge__result-snippet { font-size: 12px; color: var(--grey-600, #5F5F5F); line-height: 1.5; }

/* ── Time inner ── */
.ui-time__header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.ui-time__header-label { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); flex: 1; }
.ui-time__main { display: flex; align-items: baseline; gap: 6px; }
.ui-time__display { font-size: 42px; font-weight: 700; font-family: var(--font-mono); color: var(--fg, #1C1C1C); line-height: 1; }
.ui-time__date { font-size: 14px; color: var(--grey-600, #5F5F5F); margin-top: 4px; display: block; }
.ui-time__zone { font-size: 12px; color: var(--grey-500, #8A8A8A); }
.ui-time__world-list { display: flex; flex-direction: column; gap: 0; }
.ui-time__world-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 7px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.ui-time__world-row:last-child { border-bottom: none; }
.ui-time__world-name { font-size: 13px; color: var(--grey-700, #3D3D3D); font-weight: 500; }
.ui-time__world-right { display: flex; align-items: center; gap: 8px; }
.ui-time__world-time { font-size: 13px; font-weight: 700; font-family: var(--font-mono); color: var(--fg, #1C1C1C); }
.ui-time__world-offset { font-size: 11px; color: var(--grey-400, #B5B5B5); }

/* ── System Info inner ── */
.ui-system__header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.ui-system__hostname { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); flex: 1; font-family: var(--font-mono); }
.ui-system__os-version { font-size: 11px; color: var(--grey-500, #8A8A8A); }
.ui-system__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.ui-system__grid--compact { grid-template-columns: 1fr 1fr; gap: 8px; }
.ui-system__metric { padding: 10px; border-radius: 8px; background: var(--grey-50, #FAFAFA); border: 1px solid var(--grey-100, #F5F5F5); }
.ui-system__metric-header { display: flex; align-items: center; gap: 5px; margin-bottom: 4px; }
.ui-system__metric-label { font-size: 10px; font-weight: 600; text-transform: uppercase; color: var(--grey-500, #8A8A8A); letter-spacing: 0.08em; }
.ui-system__metric-value { font-size: 13px; font-weight: 600; font-family: var(--font-mono); color: var(--fg, #1C1C1C); display: block; }

/* ── Device inner ── */
.ui-device__header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.ui-device__header-title { font-size: 13px; font-weight: 600; color: var(--fg, #1C1C1C); flex: 1; }
.ui-device__list { display: flex; flex-direction: column; }
.ui-device__item {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 0; border-bottom: 1px solid var(--grey-100, #F5F5F5);
}
.ui-device__item:last-child { border-bottom: none; }
.ui-device__dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.ui-device__dot--online { background: #16A34A; }
.ui-device__dot--offline { background: var(--grey-300, #D9D9D9); }
.ui-device__icon { display: flex; align-items: center; flex-shrink: 0; }
.ui-device__body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.ui-device__name { font-size: 13px; font-weight: 500; color: var(--fg, #1C1C1C); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ui-device__room { font-size: 11px; color: var(--grey-500, #8A8A8A); }
.ui-device__right { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.ui-device__ip { font-family: var(--font-mono); font-size: 11px; color: var(--grey-400, #B5B5B5); }
.ui-device__empty {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 16px 0; color: var(--grey-400, #B5B5B5); font-size: 12px;
}

/* =============================================================================
   Debrief Cards — animated schedule run result cards
   ============================================================================= */

@keyframes blink-cursor {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0; }
}

@keyframes grow-bar {
  from { height: 0; }
  to   { height: var(--bar-height); }
}

.debrief-card {
  background: #fff;
  border: 1px solid var(--grey-200, #EDEDED);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* ── Colour variants — top border accent ── */
.debrief-card--daily  { border-top: 3px solid #F59E0B; }
.debrief-card--weekly { border-top: 3px solid #3B82F6; }
.debrief-card--memory { border-top: 3px solid #8B5CF6; }

/* ── Header ── */
.debrief-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px 10px;
  border-bottom: 1px solid var(--grey-100, #F5F5F5);
  background: var(--grey-50, #FAFAFA);
}

.debrief-hd--daily  { background: #FFFBEB; }
.debrief-hd--weekly { background: #EFF6FF; }
.debrief-hd--memory { background: #F5F3FF; }

.debrief-hd__left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.debrief-hd__right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.debrief-hd__icon {
  color: var(--grey-600);
  flex-shrink: 0;
}

.debrief-hd--daily  .debrief-hd__icon { color: #D97706; }
.debrief-hd--weekly .debrief-hd__icon { color: #2563EB; }
.debrief-hd--memory .debrief-hd__icon { color: #7C3AED; }

.debrief-hd__title {
  font-weight: 600;
  font-size: 14px;
  color: var(--fg);
  line-height: 1.2;
}

.debrief-hd__meta {
  font-size: 11px;
  color: var(--grey-500);
  margin-top: 1px;
}

.debrief-chip-label {
  font-size: 10px !important;
}

/* ── Typewriter zone ── */
.debrief-tw-zone {
  padding: 14px;
  background: #fff;
  max-height: 220px;
  overflow-y: auto;
  border-bottom: 1px solid var(--grey-100, #F5F5F5);
}

.debrief-tw-zone::-webkit-scrollbar { width: 6px; }
.debrief-tw-zone::-webkit-scrollbar-thumb { background: var(--grey-200); border-radius: 6px; }

.debrief-tw {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.65;
  color: var(--fg);
  white-space: pre-wrap;
  word-break: break-word;
  margin: 0;
}

.debrief-cursor {
  display: inline-block;
  width: 2px;
  height: 1em;
  background: var(--fg);
  margin-left: 1px;
  vertical-align: text-bottom;
  animation: blink-cursor 0.8s step-end infinite;
}

/* ── Body (revealed after typewriter) ── */
.debrief-body {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ── Stats grid — 4 cells ── */
.debrief-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.debrief-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 10px 6px 8px;
  border-radius: 10px;
  background: var(--grey-50);
  border: 1px solid var(--grey-100);
  text-align: center;
}

.debrief-stat__icon {
  color: var(--grey-400);
}

.debrief-stat__num {
  font-size: 22px;
  font-weight: 700;
  font-family: var(--font-heading);
  color: var(--fg);
  line-height: 1;
}

.debrief-stat__label {
  font-size: 10px;
  color: var(--grey-500);
  font-weight: 500;
  letter-spacing: 0.03em;
}

/* ── Priority highlight ── */
.debrief-priority {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #FFFBEB;
  border: 1px solid #FDE68A;
}

.debrief-priority__icon {
  color: #D97706;
  flex-shrink: 0;
  margin-top: 2px;
}

.debrief-priority__label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #92400E;
  margin-bottom: 2px;
}

.debrief-priority__text {
  font-size: 13px;
  color: #78350F;
  line-height: 1.4;
}

/* ── Focus CTA ── */
.debrief-focus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: var(--grey-50);
  border: 1px solid var(--grey-200);
}

.debrief-focus__text {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--fg);
}

.debrief-focus__text svg {
  color: var(--purple-500, #8C4BFF);
}

/* ── Big numbers (weekly report) ── */
.debrief-bignums {
  display: flex;
  gap: 0;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--grey-200);
}

.debrief-bignum {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 6px;
  background: var(--grey-50);
  text-align: center;
  border-right: 1px solid var(--grey-200);
}

.debrief-bignum:last-child { border-right: none; }

.debrief-bignum__num {
  font-size: 26px;
  font-weight: 700;
  font-family: var(--font-heading);
  color: var(--fg);
  line-height: 1;
}

.debrief-bignum__label {
  font-size: 10px;
  color: var(--grey-500);
  margin-top: 4px;
  font-weight: 500;
}

/* ── Bar chart ── */
.debrief-bars {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 72px;
  padding: 4px 0 0;
}

.debrief-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  height: 100%;
}

.debrief-bar-fill {
  width: 100%;
  max-width: 28px;
  height: var(--bar-height, 0%);
  border-radius: 4px 4px 0 0;
  background: var(--purple-300, #C4B5FD);
  animation: grow-bar 0.6s var(--ease-out, ease-out) both;
  animation-delay: calc(var(--bar-index, 0) * 60ms);
}

.debrief-bar-label {
  font-size: 10px;
  color: var(--grey-400);
  font-weight: 500;
}

/* ── Topic tag cloud ── */
.debrief-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.debrief-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-pill, 9999px);
  background: var(--grey-100);
  color: var(--grey-700);
  font-size: 11px;
  font-weight: 500;
}

/* ── Memory compaction ── */
.debrief-counter {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 16px 0 8px;
}

.debrief-counter__num {
  font-size: 48px;
  font-weight: 700;
  font-family: var(--font-heading);
  color: var(--fg);
  line-height: 1;
}

.debrief-counter__phase {
  font-size: 12px;
  color: var(--grey-500);
  min-height: 18px;
  transition: color 200ms;
}

.debrief-counter__phase[data-phase="removing"] {
  color: var(--color-danger, #FF3B30);
}

.debrief-counter__phase[data-phase="after"] {
  color: var(--color-success, #34C759);
}

.debrief-counter__skip {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 11px;
  color: var(--grey-400);
  text-decoration: underline;
  text-decoration-style: dashed;
  text-underline-offset: 2px;
  padding: 2px 4px;
  font-family: var(--font-body);
}

.debrief-counter__skip:hover { color: var(--grey-600); }

/* Memory chip grid */
.debrief-chipgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.debrief-chip {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-pill, 9999px);
  font-size: 11px;
  font-weight: 500;
  border: 1px solid transparent;
  transition: opacity 300ms, text-decoration 300ms;
}

.debrief-chip--kept {
  background: var(--purple-50, #F3EFFF);
  color: var(--purple-700, #5B21B6);
  border-color: var(--purple-100, #DDD5FF);
}

.debrief-chip--removing {
  background: var(--grey-100);
  color: var(--grey-500);
  text-decoration: line-through;
  opacity: 0.7;
}

.debrief-chip--removed {
  background: var(--grey-50);
  color: var(--grey-400);
  text-decoration: line-through;
  opacity: 0.4;
  border-color: var(--grey-100);
}

/* Dedup progress bar */
.debrief-dedup {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.debrief-dedup__labels {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--grey-500);
  font-weight: 500;
}

.debrief-dedup__track {
  height: 6px;
  border-radius: 3px;
  background: var(--grey-100);
  overflow: hidden;
}

.debrief-dedup__fill {
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--purple-400, #A855F7), var(--purple-600, #7C3AED));
}

/* ── Close button ── */
.debrief-close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--grey-500);
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.debrief-close:hover {
  background: var(--grey-100);
  color: var(--grey-700);
}
