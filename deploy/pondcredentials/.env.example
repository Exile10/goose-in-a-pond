# Public configuration, not credentials. Copy to .env and fill in. The Apple key itself is a FILE,
# never a variable: runtime/secrets/apple.p8.
CREDENTIALS_HOST=credentials.example.org
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Days a token lives (1 to 182, Apple's ceiling); a household fetches about once a month.
TOKEN_TTL_DAYS=30
# Requests per minute per client before a 429.
RATE_LIMIT_PER_MINUTE=20
