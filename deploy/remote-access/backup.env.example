# Copy to runtime/secrets/backup.env (mode 0600) and say where backups go.
# Either a destination this host pushes to with rsync over SSH (the user running
# backup.sh needs a key for it), or `pull` when another machine collects
# runtime/backups itself and verifies them, as the pilot's Mac does.
BACKUP_OFFSITE=backup@backup-host.example:/srv/goose-backups
# BACKUP_OFFSITE=pull
